package(default_visibility = ["//visibility:public"])

constraint_setting(name = "libc")

constraint_value(
    name = "musl",
    constraint_setting = ":libc",
)

platform(
    name = "linux_amd64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":musl",
    ],
)

platform(
    name = "linux_arm64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        ":musl",
    ],
)

# BuildBuddy RBE worker (default pool is linux/amd64)
platform(
    name = "linux_amd64_rbe",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        # tests run on the first execution platform matching the (musl) target platform
        ":musl",
    ],
    exec_properties = {
        "OSFamily": "Linux",
        "Arch": "amd64",
        # the default worker image is too old (glibc < 2.27) for the LLVM binaries
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04:latest",
        # database tests start PostgreSQL through testcontainers: run them in a Firecracker VM with dockerd
        "test.workload-isolation-type": "firecracker",
        "test.init-dockerd": "true",
    },
)

# Lets tests for musl targets run on a glibc Linux host (--config=release on a CI runner). The default test
# toolchain requires the exec platform to carry every target constraint, including `:musl`.
toolchain(
    name = "musl_test_toolchain",
    exec_compatible_with = ["@platforms//os:linux"],
    target_compatible_with = [
        "@platforms//os:linux",
        ":musl",
    ],
    toolchain = "@bazel_tools//tools/test:empty_toolchain",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
)

platform(
    name = "wasm32_wasip2",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
        "@rules_rust//rust/platform:wasi_preview_2",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
