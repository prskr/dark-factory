package(default_visibility = ["//visibility:public"])

constraint_setting(name = "libc")

constraint_value(
    name = "musl",
    constraint_setting = ":libc",
)

platform(
    name = "linux_amd64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
        ":musl",
    ],
)

platform(
    name = "linux_arm64_musl",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
        ":musl",
    ],
)

# Execution platform of the BuildBuddy workers (`--config=rbe`, docs/development.md). Not musl: exec tools
# (build scripts, proc-macros) are glibc. The image is BuildBuddy's public Ubuntu 24.04 executor image, pinned
# by the digest of its multi-arch index.
platform(
    name = "linux_amd64_rbe",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
    exec_properties = {
        "Arch": "amd64",
        "OSFamily": "Linux",
        "container-image": "docker://gcr.io/flame-public/rbe-ubuntu24-04@sha256:be9853fc45092d2cf2bda3abed30d22182881659a50bf35c7125161d7cfc8a75",
    },
)

# Default target platform on Linux hosts (`build:linux` in .bazelrc): the host's cpu with musl, so tests
# run the same static binaries that go into the images. The exec platform stays the plain (glibc) host.
platform(
    name = "host_musl",
    constraint_values = [":musl"],
    parents = ["@platforms//host"],
)

# Lets tests for musl targets run on a glibc Linux host. The default test toolchain requires the exec
# platform to carry every target constraint, including `:musl`.
toolchain(
    name = "musl_test_toolchain",
    exec_compatible_with = ["@platforms//os:linux"],
    target_compatible_with = [
        "@platforms//os:linux",
        ":musl",
    ],
    toolchain = "@bazel_tools//tools/test:empty_toolchain",
    toolchain_type = "@bazel_tools//tools/test:default_test_toolchain_type",
)

platform(
    name = "wasm32_wasip2",
    constraint_values = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
        "@rules_rust//rust/platform:wasi_preview_2",
    ],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)
