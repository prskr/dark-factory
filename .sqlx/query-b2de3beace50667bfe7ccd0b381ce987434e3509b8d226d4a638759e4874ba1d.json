  "query": "\n        SELECT r.task_id, t.branch AS task_branch, t.persona_id, p.name\n        FROM runs r\n        JOIN tasks t ON t.id = r.task_id\n        JOIN personas p ON p.id = t.persona_id\n        WHERE r.id = $1\n        ",
