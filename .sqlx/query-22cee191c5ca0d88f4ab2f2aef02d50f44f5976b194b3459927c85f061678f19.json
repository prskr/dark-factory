{
  "db_name": "PostgreSQL",
  "query": "SELECT r.id AS run_id, r.pod_ip AS \"pod_ip!\", t.key AS task_key, r.number AS run_number, p.id AS project_id,\n                  p.key AS project_key, t.persona_id\n           FROM runs r\n           JOIN tasks t ON t.id = r.task_id\n           JOIN projects p ON p.id = t.project_id\n           WHERE r.pod_ip IS NOT NULL\n             AND r.state NOT IN ('succeeded', 'failed', 'cancelled')\n           ORDER BY r.started_at, r.id",
