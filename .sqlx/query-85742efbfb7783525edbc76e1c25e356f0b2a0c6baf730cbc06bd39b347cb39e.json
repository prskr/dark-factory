{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT p.key AS \"key!\", p.name AS \"name!\",\n               count(t.id) FILTER (WHERE $1::text[] IS NULL OR t.status = ANY($1))\n                   AS \"task_count!\"\n        FROM projects p\n        LEFT JOIN tasks t ON t.project_id = p.id AND t.kind = 'task'\n        GROUP BY p.id\n        ORDER BY p.name, p.key\n        ",
