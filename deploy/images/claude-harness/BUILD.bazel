load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@npm_claude_harness//:defs.bzl", "npm_link_all_packages")
load("@rules_img//img:image.bzl", "image_index", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@rules_img//img:push.bzl", "image_push")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//deploy/images:musl.bzl", "musl_runtime_files", "patched_binary")
load(":npm_files.bzl", "npm_files_without_packages")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

# Node.js and the Claude Code CLI with the interpreter and the library path of this image, so the
# kernel starts them directly in any project image, glibc or musl (design D6 of
# iter3-opencode-harness). No launcher: `process.execPath` is the real binary. patchelf has to keep
# the CLI, a Bun single-file executable, working: the ACP test runs `bin/claude --version`.
patched_binary(
    name = "node_patched",
    srcs = select({
        "@platforms//cpu:aarch64": ["@node_linux_arm64_musl//:bin/node"],
        "@platforms//cpu:x86_64": ["@node_linux_amd64_musl//:bin/node"],
    }),
    out = "node",
    prefix = "/opt/harness/claude-code",
)

patched_binary(
    name = "claude_patched",
    srcs = select({
        "@platforms//cpu:aarch64": [":node_modules/@anthropic-ai/claude-agent-sdk-linux-arm64-musl"],
        "@platforms//cpu:x86_64": [":node_modules/@anthropic-ai/claude-agent-sdk-linux-x64-musl"],
    }),
    out = "claude",
    member = "claude",
    prefix = "/opt/harness/claude-code",
)

# The adapter with its dependencies, without the unpatched Claude Code CLI that the SDK package
# brings along (~200 MB): `bin/claude` is built from that package above, and the adapter finds it
# through CLAUDE_CODE_EXECUTABLE.
npm_files_without_packages(
    name = "npm_packages",
    src = ":node_modules/@agentclientprotocol/claude-agent-acp",
    package_prefixes = ["@anthropic-ai/claude-agent-sdk-linux-"],
)

image_layer(
    name = "layer",
    srcs = {
        # package_relative: node_modules/... below the image root
        "/": ":npm_packages",
        "/bin/node": ":node_patched",
        "/bin/claude": ":claude_patched",
    } | musl_runtime_files(),
    file_metadata = {
        "/bin/node": file_metadata(mode = "0755"),
        "/bin/claude": file_metadata(mode = "0755"),
    },
    include_runfiles = False,
)

image_manifest(
    name = "manifest",
    layers = [":layer"],
)

image_index(
    name = "image",
    manifests = [":manifest"],
    platforms = [
        "//build/platforms:linux_amd64_musl",
        "//build/platforms:linux_arm64_musl",
    ],
)

filegroup(
    name = "oci_layout",
    srcs = [":image"],
    output_group = "oci_layout",
)

filegroup(
    name = "digest",
    srcs = [":image"],
    output_group = "digest",
)

# The adapter version from package.json in releases, `dev` for //deploy:dev:
# `bazel run //deploy/images/claude-harness:push --//deploy/images/claude-harness:image_tag=<adapter version>`
string_flag(
    name = "image_tag",
    build_setting_default = "dev",
)

image_push(
    name = "push",
    build_settings = {"TAG": ":image_tag"},
    image = ":image",
    registry = "ghcr.io",
    repository = "prskr/dark-factory/claude-harness",
    tag = "{{.TAG}}",
    tool_cfg = "target",
)

TEST_ARGS = [
    "$(rootpath //deploy/images:lib.sh)",
    "$(rootpath @multitool//tools/jq)",
    "$(rootpath :oci_layout)",
    "$(rootpath package.json)",
]

TEST_DATA = [
    "//deploy/images:lib.sh",
    "package.json",
    ":oci_layout",
    "@multitool//tools/jq",
]

# both architectures, no container runtime needed (Linux hosts: `readelf`, `file`)
sh_test(
    name = "structure_test",
    srcs = ["test.sh"],
    args = TEST_ARGS,
    data = TEST_DATA,
    target_compatible_with = ["@platforms//os:linux"],
)

# ACP `initialize` and `bin/claude --version` from the mounted volume in a glibc and a musl project
# image. It needs a container runtime, which the Bazel sandbox hides, so the test runs without the
# sandbox (`no-sandbox`) and takes the CLI and the socket from the environment:
#   bazel --bazelrc=.bazelrc.agents test //deploy/images/claude-harness:test \\
#     --test_env=CONTAINER_CLI --test_env=DOCKER_HOST=unix://<socket>
# `external` marks a test that needs more than the repository.
sh_test(
    name = "test",
    srcs = ["test.sh"],
    args = TEST_ARGS + ["--acp"],
    data = TEST_DATA,
    tags = [
        "external",
        "no-remote-exec",
        "no-sandbox",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
