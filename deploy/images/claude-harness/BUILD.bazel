load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@npm_claude_harness//:defs.bzl", "npm_link_all_packages")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_img//img:image.bzl", "image_index", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@rules_img//img:push.bzl", "image_push")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//build:optimized.bzl", "optimized")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

cc_binary(
    name = "launcher_bin",
    srcs = ["launcher.c"],
    linkopts = ["-static"],
    target_compatible_with = ["@platforms//os:linux"],
)

optimized(
    name = "launcher",
    src = ":launcher_bin",
)

# The adapter with its dependencies, and the Claude Code CLI of the architecture at the version-free
# path the launcher uses (hoisted in MODULE.bazel).
filegroup(
    name = "npm_packages",
    srcs = [":node_modules/@agentclientprotocol/claude-agent-acp"] + select({
        "@platforms//cpu:aarch64": [":node_modules/@anthropic-ai/claude-agent-sdk-linux-arm64-musl"],
        "@platforms//cpu:x86_64": [":node_modules/@anthropic-ai/claude-agent-sdk-linux-x64-musl"],
    }),
)

image_layer(
    name = "layer",
    srcs = {
        # package_relative: node_modules/... below the image root
        "/": ":npm_packages",
        "/bin/claude-agent-acp": ":launcher",
    } | select({
        "@platforms//cpu:aarch64": {
            "/lib/ld-musl-aarch64.so.1": "@musl_runtime_linux_arm64//:lib/libc.so",
            "/lib/libgcc_s.so.1": "@musl_runtime_linux_arm64//:lib/libgcc_s.so.1",
            "/lib/libstdc++.so.6": "@musl_runtime_linux_arm64//:usr/lib/libstdc++.so.6",
            "/node": "@node_linux_arm64_musl//:bin/node",
        },
        "@platforms//cpu:x86_64": {
            "/lib/ld-musl-x86_64.so.1": "@musl_runtime_linux_amd64//:lib/libc.so",
            "/lib/libgcc_s.so.1": "@musl_runtime_linux_amd64//:lib/libgcc_s.so.1",
            "/lib/libstdc++.so.6": "@musl_runtime_linux_amd64//:usr/lib/libstdc++.so.6",
            "/node": "@node_linux_amd64_musl//:bin/node",
        },
    }),
    file_metadata = {
        "/bin/claude-agent-acp": file_metadata(mode = "0755"),
    },
    include_runfiles = False,
    symlinks = {
        "/bin/claude": "claude-agent-acp",
    },
)

image_manifest(
    name = "manifest",
    layers = [":layer"],
)

image_index(
    name = "image",
    manifests = [":manifest"],
    platforms = [
        "//build/platforms:linux_amd64_musl",
        "//build/platforms:linux_arm64_musl",
    ],
)

filegroup(
    name = "oci_layout",
    srcs = [":image"],
    output_group = "oci_layout",
)

filegroup(
    name = "digest",
    srcs = [":image"],
    output_group = "digest",
)

# The adapter version from package.json in releases, `dev` for //deploy:dev:
# `bazel run //deploy/images/claude-harness:push --//deploy/images/claude-harness:image_tag=<adapter version>`
string_flag(
    name = "image_tag",
    build_setting_default = "dev",
)

image_push(
    name = "push",
    build_settings = {"TAG": ":image_tag"},
    image = ":image",
    registry = "ghcr.io",
    repository = "prskr/dark-factory/claude-harness",
    tag = "{{.TAG}}",
    tool_cfg = "target",
)

TEST_ARGS = [
    "$(rootpath @multitool//tools/jq)",
    "$(rootpath :oci_layout)",
    "$(rootpath package.json)",
]

TEST_DATA = [
    "package.json",
    ":oci_layout",
    "@multitool//tools/jq",
]

# both architectures, no container runtime needed (Linux hosts: `readelf`, `file`)
sh_test(
    name = "structure_test",
    srcs = ["test.sh"],
    args = TEST_ARGS,
    data = TEST_DATA,
    target_compatible_with = ["@platforms//os:linux"],
)

# ACP handshake in a glibc and a musl project image: `CONTAINER_CLI=podman bazel run :handshake`
sh_binary(
    name = "handshake",
    srcs = ["test.sh"],
    args = TEST_ARGS + ["--handshake"],
    data = TEST_DATA,
)
