load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_img//img:image.bzl", "image_index", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@rules_img//img:push.bzl", "image_push")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//deploy/images:musl.bzl", "musl_runtime_files", "patched_binary")

package(default_visibility = ["//visibility:public"])

# The release binary with the interpreter and the library path of this image. `opencode acp` starts
# its server as a child by running `process.execPath` again, so the binary must be started by the
# kernel itself: a launcher that runs the musl loader would make
# the child run the loader without a program. With the interpreter at the image path, the same
# binary starts in any project image, glibc or musl, and needs no `LD_LIBRARY_PATH` that would leak
# into the tools the agent runs.
patched_binary(
    name = "opencode_patched",
    srcs = select({
        "@platforms//cpu:aarch64": ["@opencode_linux_arm64_musl//:opencode"],
        "@platforms//cpu:x86_64": ["@opencode_linux_amd64_musl//:opencode"],
    }),
    out = "opencode",
    prefix = "/opt/harness/opencode",
)

image_layer(
    name = "layer",
    srcs = {
        "/bin/opencode": ":opencode_patched",
    } | musl_runtime_files(),
    file_metadata = {
        "/bin/opencode": file_metadata(mode = "0755"),
    },
    include_runfiles = False,
)

image_manifest(
    name = "manifest",
    layers = [":layer"],
)

image_index(
    name = "image",
    manifests = [":manifest"],
    platforms = [
        "//build/platforms:linux_amd64_musl",
        "//build/platforms:linux_arm64_musl",
    ],
)

filegroup(
    name = "oci_layout",
    srcs = [":image"],
    output_group = "oci_layout",
)

filegroup(
    name = "digest",
    srcs = [":image"],
    output_group = "digest",
)

# The OpenCode version in releases, `dev` for //deploy:dev:
# `bazel run //deploy/images/opencode-harness:push --//deploy/images/opencode-harness:image_tag=<version>`
string_flag(
    name = "image_tag",
    build_setting_default = "dev",
)

image_push(
    name = "push",
    build_settings = {"TAG": ":image_tag"},
    image = ":image",
    registry = "ghcr.io",
    repository = "prskr/dark-factory/opencode-harness",
    tag = "{{.TAG}}",
    tool_cfg = "target",
)

TEST_DATA = [
    "//crates/df-core:testdata/opencode-config.json",
    "//deploy/images:lib.sh",
    ":oci_layout",
    "@multitool//tools/jq",
]

# both architectures, no container runtime needed (Linux hosts: `readelf`, `file`)
sh_test(
    name = "structure_test",
    srcs = ["test.sh"],
    args = [
        "$(rootpath //deploy/images:lib.sh)",
        "$(rootpath @multitool//tools/jq)",
        "$(rootpath :oci_layout)",
    ],
    data = TEST_DATA,
    target_compatible_with = ["@platforms//os:linux"],
)

# ACP `initialize` and `session/new` through `bin/opencode acp` in a project image without musl.
# It needs a container runtime, which the Bazel sandbox hides, so the test runs without the
# sandbox (`no-sandbox`) and takes the CLI and the socket from the environment:
#   bazel --bazelrc=.bazelrc.agents test //deploy/images/opencode-harness:test \
#     --test_env=CONTAINER_CLI --test_env=DOCKER_HOST=unix://<socket>
# `external` marks a test that needs more than the repository.
sh_test(
    name = "test",
    srcs = ["test.sh"],
    args = [
        "$(rootpath //deploy/images:lib.sh)",
        "$(rootpath @multitool//tools/jq)",
        "$(rootpath :oci_layout)",
        "--acp",
        "$(rootpath //crates/df-core:testdata/opencode-config.json)",
    ],
    data = TEST_DATA,
    tags = [
        "external",
        "no-sandbox",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)
