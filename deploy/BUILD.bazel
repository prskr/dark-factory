load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_img//img:image.bzl", "image_index", "image_manifest")
load("@rules_img//img:layer.bzl", "file_metadata", "image_layer")
load("@rules_img//img:multi_deploy.bzl", "multi_deploy")
load("@rules_img//img:push.bzl", "image_push")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")
load("//build:optimized.bzl", "optimized")

package(default_visibility = ["//visibility:public"])

LINUX_MUSL_PLATFORMS = [
    "//build/platforms:linux_amd64_musl",
    "//build/platforms:linux_arm64_musl",
]

# Shipped binaries are optimized builds even without `-c opt`: the forgejo component is
# ~0.3 MB instead of ~6.9 MB, the control plane ~84 MB instead of ~224 MB.
optimized(
    name = "forgejo_plugin",
    src = "//plugins/forgejo",
)

optimized(
    name = "github_plugin",
    src = "//plugins/github",
)

optimized(
    name = "dark_factory",
    src = "//crates/dark-factory",
)

optimized(
    name = "factory_agent",
    src = "//crates/factory-agent",
)

optimized(
    name = "fake_acp_agent",
    src = "//crates/fake-acp-agent",
)

image_layer(
    name = "control_plane_layer",
    srcs = {
        "/dark-factory": ":dark_factory",
    },
    file_metadata = {
        "/dark-factory": file_metadata(mode = "0755"),
    },
    include_runfiles = False,
)

image_manifest(
    name = "control_plane_manifest",
    base = "@distroless_static_debian13_nonroot",
    entrypoint = ["/dark-factory"],
    layers = [":control_plane_layer"],
)

image_index(
    name = "control_plane_image",
    manifests = [":control_plane_manifest"],
    platforms = LINUX_MUSL_PLATFORMS,
    tags = ["oci_image"],
)

filegroup(
    name = "control_plane_digest",
    srcs = [":control_plane_image"],
    output_group = "digest",
)

filegroup(
    name = "control_plane_oci_layout",
    srcs = [":control_plane_image"],
    output_group = "oci_layout",
)

# Plugin images are image volumes of the control plane pod (mounted at /plugins/<name>). The
# component is architecture independent, so both platforms reference the same layer.
image_layer(
    name = "plugin_forgejo_layer",
    srcs = {
        "/plugin.wasm": ":forgejo_plugin",
    },
    file_metadata = {
        "/plugin.wasm": file_metadata(mode = "0644"),
    },
    include_runfiles = False,
)

image_manifest(
    name = "plugin_forgejo_manifest",
    layers = [":plugin_forgejo_layer"],
)

image_index(
    name = "plugin_forgejo_image",
    manifests = [":plugin_forgejo_manifest"],
    platforms = LINUX_MUSL_PLATFORMS,
    tags = ["oci_image"],
)

filegroup(
    name = "plugin_forgejo_digest",
    srcs = [":plugin_forgejo_image"],
    output_group = "digest",
)

filegroup(
    name = "plugin_forgejo_oci_layout",
    srcs = [":plugin_forgejo_image"],
    output_group = "oci_layout",
)

image_layer(
    name = "plugin_github_layer",
    srcs = {
        "/plugin.wasm": ":github_plugin",
    },
    file_metadata = {
        "/plugin.wasm": file_metadata(mode = "0644"),
    },
    include_runfiles = False,
)

image_manifest(
    name = "plugin_github_manifest",
    layers = [":plugin_github_layer"],
)

image_index(
    name = "plugin_github_image",
    manifests = [":plugin_github_manifest"],
    platforms = LINUX_MUSL_PLATFORMS,
    tags = ["oci_image"],
)

filegroup(
    name = "plugin_github_digest",
    srcs = [":plugin_github_image"],
    output_group = "digest",
)

filegroup(
    name = "plugin_github_oci_layout",
    srcs = [":plugin_github_image"],
    output_group = "oci_layout",
)

image_layer(
    name = "runtime_layer",
    srcs = {
        "/factory-agent": ":factory_agent",
        "/gitconfig": "//crates/factory-agent:image/gitconfig",
        "/hooks-empty": "//crates/factory-agent:hooks_empty",
    },
    file_metadata = {
        "/factory-agent": file_metadata(mode = "0755"),
        "/gitconfig": file_metadata(mode = "0644"),
        "/hooks-empty": file_metadata(mode = "0755"),
    },
    include_runfiles = False,
)

image_manifest(
    name = "runtime_manifest",
    layers = [":runtime_layer"],
)

image_index(
    name = "runtime_image",
    manifests = [":runtime_manifest"],
    platforms = LINUX_MUSL_PLATFORMS,
    tags = ["oci_image"],
)

filegroup(
    name = "runtime_digest",
    srcs = [":runtime_image"],
    output_group = "digest",
)

filegroup(
    name = "runtime_oci_layout",
    srcs = [":runtime_image"],
    output_group = "oci_layout",
)

image_layer(
    name = "test_project_layer",
    srcs = {
        "/opt/harness/bin/fake-acp-agent": ":fake_acp_agent",
    },
    file_metadata = {
        "/opt/harness/bin/fake-acp-agent": file_metadata(mode = "0755"),
    },
    include_runfiles = False,
)

image_manifest(
    name = "test_project_manifest",
    base = "@debian_trixie_git",
    layers = [":test_project_layer"],
)

image_index(
    name = "test_project_image",
    manifests = [":test_project_manifest"],
    platforms = LINUX_MUSL_PLATFORMS,
    tags = ["oci_image"],
)

filegroup(
    name = "test_project_digest",
    srcs = [":test_project_image"],
    output_group = "digest",
)

filegroup(
    name = "test_project_oci_layout",
    srcs = [":test_project_image"],
    output_group = "oci_layout",
)

# Tag of the pushed images: `bazel run //deploy:push_images --//deploy:image_tag=v1.2.3` (release workflow)
string_flag(
    name = "image_tag",
    build_setting_default = "dev",
)

image_push(
    name = "push_control_plane",
    build_settings = {"TAG": ":image_tag"},
    image = ":control_plane_image",
    registry = "ghcr.io",
    repository = "prskr/dark-factory/control-plane",
    tag = "{{.TAG}}",
    tool_cfg = "target",
)

image_push(
    name = "push_plugin_forgejo",
    build_settings = {"TAG": ":image_tag"},
    image = ":plugin_forgejo_image",
    registry = "ghcr.io",
    repository = "prskr/dark-factory/plugin-forgejo",
    tag = "{{.TAG}}",
    tool_cfg = "target",
)

image_push(
    name = "push_plugin_github",
    build_settings = {"TAG": ":image_tag"},
    image = ":plugin_github_image",
    registry = "ghcr.io",
    repository = "prskr/dark-factory/plugin-github",
    tag = "{{.TAG}}",
    tool_cfg = "target",
)

image_push(
    name = "push_runtime",
    build_settings = {"TAG": ":image_tag"},
    image = ":runtime_image",
    registry = "ghcr.io",
    repository = "prskr/dark-factory/runtime",
    tag = "{{.TAG}}",
    tool_cfg = "target",
)

image_push(
    name = "push_test_project",
    build_settings = {"TAG": ":image_tag"},
    image = ":test_project_image",
    registry = "ghcr.io",
    repository = "prskr/dark-factory/test-project",
    tag = "{{.TAG}}",
    tool_cfg = "target",
)

multi_deploy(
    name = "push_images",
    operations = [
        ":push_control_plane",
        ":push_plugin_forgejo",
        ":push_plugin_github",
        ":push_runtime",
        ":push_test_project",
    ],
    tool_cfg = "target",
)

filegroup(
    name = "helm_chart_files",
    srcs = glob(["helm/dark-factory/**"]),
)

sh_binary(
    name = "dev",
    srcs = ["dev.sh"],
    args = [
        "$(location :push_images)",
        "$(location :control_plane_digest)",
        "$(location :runtime_digest)",
        "$(location :test_project_digest)",
        "$(location :plugin_forgejo_digest)",
        "$(location //deploy/images/claude-harness:push)",
        "$(location //deploy/images/claude-harness:digest)",
        "$(location helm/dark-factory/Chart.yaml)",
        "$(location values-dev.yaml)",
    ],
    data = [
        "helm/dark-factory/Chart.yaml",
        "values-dev.yaml",
        ":control_plane_digest",
        ":helm_chart_files",
        ":plugin_forgejo_digest",
        ":push_images",
        ":runtime_digest",
        ":test_project_digest",
        "//deploy/images/claude-harness:digest",
        "//deploy/images/claude-harness:push",
    ],
)

# checks the multi-arch index and that the binaries are static musl ELFs (Linux hosts only)
sh_test(
    name = "images_structure_test",
    srcs = ["test_images.sh"],
    args = [
        "$(rootpath @multitool//tools/jq)",
        "$(location :control_plane_oci_layout)",
        "$(location :runtime_oci_layout)",
        "$(location :test_project_oci_layout)",
        "$(location :plugin_forgejo_oci_layout)",
        "$(location :plugin_github_oci_layout)",
    ],
    data = [
        ":control_plane_oci_layout",
        ":plugin_forgejo_oci_layout",
        ":plugin_github_oci_layout",
        ":runtime_oci_layout",
        ":test_project_oci_layout",
        "@multitool//tools/jq",
    ],
    target_compatible_with = ["@platforms//os:linux"],
)

sh_test(
    name = "helm_chart_test",
    srcs = ["test_chart.sh"],
    args = [
        "$(rootpath @multitool//tools/helm)",
        "$(rootpath @multitool//tools/kubeconform)",
        "$(rootpath @multitool//tools/yq)",
        "$(rootpath @multitool//tools/kube-linter)",
        "$(rootpath //:.kube-linter.yaml)",
        "$(rootpath @k8s_json_schema//:_definitions.json)",
        "$(rootpath @crds_catalog//:cert-manager.io/certificate_v1.json)",
        "$(rootpath helm/dark-factory/Chart.yaml)",
        "$(rootpath values-dev.yaml)",
    ],
    data = [
        "helm/dark-factory/Chart.yaml",
        "values-dev.yaml",
        ":helm_chart_files",
        "//:.kube-linter.yaml",
        "@crds_catalog//:cert-manager.io/certificate_v1.json",
        "@crds_catalog//:schemas",
        "@k8s_json_schema//:_definitions.json",
        "@k8s_json_schema//:schemas",
        "@multitool//tools/helm",
        "@multitool//tools/kube-linter",
        "@multitool//tools/kubeconform",
        "@multitool//tools/yq",
    ],
)

sh_test(
    name = "helm_chart_unittest",
    srcs = ["test_chart_unit.sh"],
    args = [
        "$(rootpath @multitool//tools/helm-unittest)",
        "$(rootpath helm/dark-factory/Chart.yaml)",
    ],
    data = [
        "helm/dark-factory/Chart.yaml",
        ":helm_chart_files",
        "@multitool//tools/helm-unittest",
    ],
)
