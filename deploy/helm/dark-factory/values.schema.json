{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Dark Factory Helm Values",
  "type": "object",
  "required": [
    "instanceName",
    "image",
    "database",
    "oidc",
    "telemetry",
    "logging",
    "sandbox",
    "sandboxNamespace",
    "enforcement",
    "clusterTargets",
    "controlPlane",
    "lifecycleEvents",
    "gateway",
    "tls",
    "httpRoute",
    "networkPolicy"
  ],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "instanceName": { "type": "string", "minLength": 1 },
    "publicUrl": { "type": "string" },
    "image": {
      "type": "object",
      "required": ["pullPolicy", "controlPlane", "runtime", "harness", "testProject"],
      "properties": {
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" }
            }
          }
        },
        "controlPlane": { "$ref": "#/$defs/imageRef" },
        "runtime": { "$ref": "#/$defs/imageRef" },
        "harness": {
          "type": "object",
          "required": ["claudeCode", "opencode"],
          "properties": {
            "claudeCode": { "$ref": "#/$defs/imageRef" },
            "opencode": { "$ref": "#/$defs/imageRef" }
          }
        },
        "testProject": { "$ref": "#/$defs/imageRef" }
      }
    },
    "database": {
      "type": "object",
      "required": ["host", "port", "database", "schema", "maxConnections", "app", "owner", "migrate"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "database": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "maxConnections": { "type": "integer", "minimum": 1 },
        "app": { "$ref": "#/$defs/dbRoleSecret" },
        "owner": { "$ref": "#/$defs/dbRoleSecret" },
        "migrate": {
          "type": "object",
          "required": ["manageAppRole"],
          "properties": {
            "manageAppRole": { "type": "boolean" }
          }
        }
      }
    },
    "oidc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuerUrl", "clientId", "existingSecret", "clientSecretKey"],
      "properties": {
        "issuerUrl": { "type": "string", "minLength": 1 },
        "clientId": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "clientSecretKey": { "type": "string", "minLength": 1 },
        "rolesClaim": { "type": "string", "minLength": 1 },
        "extraScopes": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "telemetry": {
      "type": "object",
      "required": ["metrics", "traces", "otlp"],
      "properties": {
        "metrics": {
          "type": "object",
          "required": ["exporters", "port"],
          "properties": {
            "exporters": {
              "type": "array",
              "uniqueItems": true,
              "items": { "enum": ["prometheus", "otlp"] }
            },
            "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "serviceMonitor": {
              "type": "object",
              "properties": {
                "enabled": { "type": "boolean" },
                "labels": { "type": "object", "additionalProperties": { "type": "string" } },
                "interval": { "type": "string" }
              }
            }
          }
        },
        "traces": {
          "type": "object",
          "required": ["enabled"],
          "properties": {
            "enabled": { "type": "boolean" },
            "sampler": {
              "type": "string",
              "enum": [
                "always_on",
                "always_off",
                "traceidratio",
                "parentbased_always_on",
                "parentbased_always_off",
                "parentbased_traceidratio"
              ]
            },
            "samplerArg": { "type": "string" }
          }
        },
        "otlp": {
          "type": "object",
          "properties": {
            "endpoint": { "type": "string" },
            "protocol": { "type": "string", "enum": ["grpc"] },
            "insecure": { "type": "boolean" },
            "headersSecret": { "type": "string" }
          }
        }
      }
    },
    "logging": {
      "type": "object",
      "required": ["format"],
      "properties": {
        "format": { "enum": ["text", "json"] }
      }
    },
    "sandbox": {
      "type": "object",
      "required": ["logLevel"],
      "properties": {
        "logLevel": { "type": "string" }
      }
    },
    "sandboxNamespace": {
      "type": "object",
      "required": ["create", "name", "serviceAccountName", "resourceQuota", "limitRange"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "runtimeClassName": { "type": "string" },
        "storageClass": { "type": "string" },
        "pvcSize": { "type": "string" },
        "issuerName": { "type": "string" },
        "issuerKind": { "type": "string", "enum": ["", "ClusterIssuer"] },
        "issuerGroup": { "type": "string" },
        "certificateDuration": { "type": "string" },
        "certificateRenewBefore": { "type": "string" },
        "clusterDomain": { "type": "string" },
        "controlPlaneIp": { "type": "string" },
        "gatewayIp": { "type": "string" },
        "serviceAccountName": { "type": "string", "minLength": 1 },
        "resourceQuota": {
          "type": "object",
          "required": [
            "pods",
            "requestsCpu",
            "requestsMemory",
            "limitsCpu",
            "limitsMemory",
            "requestsStorage",
            "persistentVolumeClaims"
          ],
          "properties": {
            "pods": { "type": "string" },
            "requestsCpu": { "type": "string" },
            "requestsMemory": { "type": "string" },
            "limitsCpu": { "type": "string" },
            "limitsMemory": { "type": "string" },
            "requestsStorage": { "type": "string" },
            "persistentVolumeClaims": { "type": "string" }
          }
        },
        "limitRange": {
          "type": "object",
          "required": ["defaultCpu", "defaultMemory", "defaultRequestCpu", "defaultRequestMemory"],
          "properties": {
            "defaultCpu": { "type": "string" },
            "defaultMemory": { "type": "string" },
            "defaultRequestCpu": { "type": "string" },
            "defaultRequestMemory": { "type": "string" }
          }
        }
      }
    },
    "enforcement": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["kubernetes", "cilium"]
        }
      }
    },
    "clusterTargets": {
      "type": "object",
      "required": ["anyNamespace", "namespaces"],
      "properties": {
        "anyNamespace": { "type": "boolean" },
        "namespaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "plugins": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z]([-a-z0-9]{0,52}[a-z0-9])?$" },
      "additionalProperties": { "$ref": "#/$defs/plugin" }
    },
    "runs": {
      "type": "object",
      "properties": {
        "keepAliveSeconds": { "type": "integer", "minimum": 0 },
        "maxConcurrent": { "type": "integer", "minimum": 1 },
        "maxAutoResumes": { "type": "integer", "minimum": 0 }
      }
    },
    "artifacts": {
      "type": "object",
      "properties": {
        "maxTextBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "maxImageBytes": { "type": "integer", "minimum": 1, "maximum": 8388608 },
        "maxPerTask": { "type": "integer", "minimum": 1 }
      }
    },
    "volumes": {
      "type": "object",
      "properties": {
        "retainAfterCloseSeconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        "idleTtlSeconds": { "type": "integer", "minimum": 0, "maximum": 9007199254740991 }
      }
    },
    "network": {
      "type": "object",
      "properties": {
        "allowPlainHttp": { "type": "boolean" }
      }
    },
    "web": {
      "type": "object",
      "properties": {
        "showHiddenBlocks": { "type": "boolean" },
        "codeTheme": {
          "type": "object",
          "properties": {
            "light": { "$ref": "#/$defs/codeTheme" },
            "dark": { "$ref": "#/$defs/codeTheme" }
          }
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "required": ["replicas", "ports", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "logLevel": { "type": "string" },
        "serviceAccountName": { "type": "string" },
        "ports": {
          "type": "object",
          "required": ["http", "agent", "internalGrpc"],
          "properties": {
            "http": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "agent": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "internalGrpc": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "resources": { "type": "object" },
        "extraArgs": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "lifecycleEvents": {
      "type": "object",
      "required": ["signingKey", "subscriptions"],
      "properties": {
        "signingKey": {
          "type": "object",
          "required": ["existingSecret", "key"],
          "properties": {
            "existingSecret": { "type": "string" },
            "key": { "type": "string", "minLength": 1 }
          }
        },
        "subscriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["url"],
            "additionalProperties": false,
            "properties": {
              "url": { "type": "string", "pattern": "^https?://[^/?#]+" },
              "events": {
                "type": "array",
                "uniqueItems": true,
                "items": { "$ref": "#/$defs/lifecycleEventType" }
              }
            }
          }
        }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["replicas", "pdb", "ports", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "logLevel": { "type": "string" },
        "serviceAccountName": { "type": "string" },
        "pdb": {
          "type": "object",
          "required": ["enabled", "minAvailable"],
          "properties": {
            "enabled": { "type": "boolean" },
            "minAvailable": { "type": "integer", "minimum": 1 }
          }
        },
        "ports": {
          "type": "object",
          "required": ["proxy", "git", "internalGrpc", "health"],
          "properties": {
            "proxy": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "git": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "internalGrpc": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "health": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "git": {
          "type": "object",
          "required": ["mirrorSizeLimit", "maxPushSizeBytes"],
          "properties": {
            "mirrorSizeLimit": { "type": "string", "minLength": 1 },
            "maxPushSizeBytes": { "type": "integer", "minimum": 1 }
          }
        },
        "bufferSize": { "type": "integer", "minimum": 1 },
        "bufferMaxAgeSeconds": { "type": "integer", "minimum": 1 },
        "blockedCidrs": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "object" }
      }
    },
    "tls": {
      "type": "object",
      "required": ["ca", "duration", "renewBefore"],
      "properties": {
        "ca": {
          "type": "object",
          "required": ["create", "existingIssuer"],
          "properties": {
            "create": { "type": "boolean" },
            "clusterResourceNamespace": { "type": "string", "minLength": 1 },
            "existingIssuer": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "kind": { "type": "string", "enum": ["Issuer", "ClusterIssuer"] }
              }
            }
          }
        },
        "duration": { "type": "string" },
        "renewBefore": { "type": "string" }
      }
    },
    "httpRoute": {
      "type": "object",
      "required": ["enabled", "parentRefs", "hostnames"],
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        },
        "hostnames": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "properties": { "parentRefs": { "minItems": 1 } } }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressController"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressController": {
          "type": "object",
          "properties": {
            "allowAll": { "type": "boolean" },
            "namespaceSelector": { "type": "object" },
            "podSelector": { "type": "object" }
          }
        },
        "metricsScraper": {
          "type": "object",
          "properties": {
            "namespaceSelector": { "type": "object" },
            "podSelector": { "type": "object" }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "telemetry": { "properties": { "traces": { "properties": { "enabled": { "const": true } } } } } } },
      "then": { "properties": { "telemetry": { "properties": { "otlp": { "required": ["endpoint"], "properties": { "endpoint": { "minLength": 1 } } } } } } }
    },
    {
      "if": { "properties": { "telemetry": { "properties": { "metrics": { "properties": { "exporters": { "contains": { "const": "otlp" } } } } } } } },
      "then": { "properties": { "telemetry": { "properties": { "otlp": { "required": ["endpoint"], "properties": { "endpoint": { "minLength": 1 } } } } } } }
    }
  ],
  "$defs": {
    "codeTheme": {
      "enum": [
        "InspiredGitHub",
        "Solarized (light)",
        "Solarized (dark)",
        "base16-ocean.light",
        "base16-ocean.dark",
        "base16-eighties.dark",
        "base16-mocha.dark"
      ]
    },
    "plugin": {
      "type": "object",
      "properties": {
        "image": { "anyOf": [{ "type": "null" }, { "$ref": "#/$defs/imageRef" }] },
        "path": { "type": "string" },
        "callTimeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 300 },
        "memoryMib": { "type": "integer", "minimum": 1 },
        "settings": { "type": "object", "additionalProperties": { "type": "string" } },
        "hosts": {
          "type": "array",
          "items": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              {
                "type": "object",
                "properties": {
                  "host": { "type": "string", "minLength": 1 },
                  "apiUrl": { "type": "string", "pattern": "^https://" }
                },
                "required": ["host", "apiUrl"],
                "additionalProperties": false
              }
            ]
          }
        },
        "authScheme": { "enum": ["token", "bearer"] },
        "webhookSecret": {
          "anyOf": [
            { "type": "null" },
            {
              "type": "object",
              "properties": {
                "existingSecret": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?)?$"
                },
                "key": {
                  "type": "string",
                  "maxLength": 253,
                  "pattern": "^[-._a-zA-Z0-9]*$"
                }
              },
              "additionalProperties": false
            }
          ]
        }
      },
      "additionalProperties": false,
      "anyOf": [
        { "required": ["image"], "properties": { "image": { "$ref": "#/$defs/imageRef" } } },
        { "required": ["path"], "properties": { "path": { "minLength": 1 } } }
      ]
    },
    "imageRef": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" }
      }
    },
    "dbRoleSecret": {
      "type": "object",
      "required": ["user", "existingSecret", "passwordKey"],
      "properties": {
        "user": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 }
      }
    },
    "lifecycleEventType": {
      "enum": [
        "volume.provisioned",
        "volume.destroyed",
        "sandbox.provisioning",
        "sandbox.provisioned",
        "sandbox.provisioning_failed",
        "sandbox.destroyed"
      ]
    }
  }
}
