{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "Dark Factory Helm Values",
  "type": "object",
  "required": [
    "instanceName",
    "image",
    "database",
    "oidc",
    "sandboxNamespace",
    "enforcement",
    "clusterTargets",
    "controlPlane",
    "gateway",
    "tls",
    "httpRoute",
    "networkPolicy"
  ],
  "properties": {
    "nameOverride": { "type": "string" },
    "fullnameOverride": { "type": "string" },
    "instanceName": { "type": "string", "minLength": 1 },
    "image": {
      "type": "object",
      "required": ["pullPolicy", "controlPlane", "runtime", "testProject"],
      "properties": {
        "pullPolicy": {
          "type": "string",
          "enum": ["Always", "IfNotPresent", "Never"]
        },
        "pullSecrets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": {
              "name": { "type": "string" }
            }
          }
        },
        "controlPlane": { "$ref": "#/$defs/imageRef" },
        "runtime": { "$ref": "#/$defs/imageRef" },
        "testProject": { "$ref": "#/$defs/imageRef" }
      }
    },
    "database": {
      "type": "object",
      "required": ["host", "port", "database", "schema", "maxConnections", "app", "owner", "migrate"],
      "properties": {
        "host": { "type": "string", "minLength": 1 },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "database": { "type": "string", "minLength": 1 },
        "schema": { "type": "string", "minLength": 1 },
        "maxConnections": { "type": "integer", "minimum": 1 },
        "app": { "$ref": "#/$defs/dbRoleSecret" },
        "owner": { "$ref": "#/$defs/dbRoleSecret" },
        "migrate": {
          "type": "object",
          "required": ["manageAppRole"],
          "properties": {
            "manageAppRole": { "type": "boolean" }
          }
        }
      }
    },
    "oidc": {
      "type": "object",
      "required": ["issuerUrl", "clientId", "existingSecret", "clientSecretKey"],
      "properties": {
        "issuerUrl": { "type": "string", "minLength": 1 },
        "clientId": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "clientSecretKey": { "type": "string", "minLength": 1 },
        "publicUrl": { "type": "string" },
        "rolesClaim": { "type": "string", "minLength": 1 }
      }
    },
    "sandboxNamespace": {
      "type": "object",
      "required": ["create", "name", "serviceAccountName", "resourceQuota", "limitRange"],
      "properties": {
        "create": { "type": "boolean" },
        "name": { "type": "string", "minLength": 1 },
        "runtimeClassName": { "type": "string" },
        "storageClass": { "type": "string" },
        "pvcSize": { "type": "string" },
        "issuerName": { "type": "string" },
        "issuerKind": { "type": "string", "enum": ["", "ClusterIssuer"] },
        "issuerGroup": { "type": "string" },
        "certificateDuration": { "type": "string" },
        "certificateRenewBefore": { "type": "string" },
        "runtimeDelivery": { "type": "string", "enum": ["imageVolume", "initContainer"] },
        "clusterDomain": { "type": "string" },
        "controlPlaneIp": { "type": "string" },
        "gatewayIp": { "type": "string" },
        "serviceAccountName": { "type": "string", "minLength": 1 },
        "resourceQuota": {
          "type": "object",
          "required": [
            "pods",
            "requestsCpu",
            "requestsMemory",
            "limitsCpu",
            "limitsMemory",
            "requestsStorage",
            "persistentVolumeClaims"
          ],
          "properties": {
            "pods": { "type": "string" },
            "requestsCpu": { "type": "string" },
            "requestsMemory": { "type": "string" },
            "limitsCpu": { "type": "string" },
            "limitsMemory": { "type": "string" },
            "requestsStorage": { "type": "string" },
            "persistentVolumeClaims": { "type": "string" }
          }
        },
        "limitRange": {
          "type": "object",
          "required": ["defaultCpu", "defaultMemory", "defaultRequestCpu", "defaultRequestMemory"],
          "properties": {
            "defaultCpu": { "type": "string" },
            "defaultMemory": { "type": "string" },
            "defaultRequestCpu": { "type": "string" },
            "defaultRequestMemory": { "type": "string" }
          }
        }
      }
    },
    "enforcement": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["kubernetes", "cilium"]
        }
      }
    },
    "clusterTargets": {
      "type": "object",
      "required": ["anyNamespace", "namespaces"],
      "properties": {
        "anyNamespace": { "type": "boolean" },
        "namespaces": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "controlPlane": {
      "type": "object",
      "required": ["replicas", "ports", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 1 },
        "serviceAccountName": { "type": "string" },
        "ports": {
          "type": "object",
          "required": ["http", "agent", "internalGrpc"],
          "properties": {
            "http": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "agent": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "internalGrpc": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "resources": { "type": "object" }
      }
    },
    "gateway": {
      "type": "object",
      "required": ["replicas", "pdb", "ports", "resources"],
      "properties": {
        "replicas": { "type": "integer", "minimum": 2 },
        "serviceAccountName": { "type": "string" },
        "pdb": {
          "type": "object",
          "required": ["minAvailable"],
          "properties": {
            "minAvailable": { "type": "integer", "minimum": 1 }
          }
        },
        "ports": {
          "type": "object",
          "required": ["proxy", "internalGrpc", "health"],
          "properties": {
            "proxy": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "internalGrpc": { "type": "integer", "minimum": 1, "maximum": 65535 },
            "health": { "type": "integer", "minimum": 1, "maximum": 65535 }
          }
        },
        "bufferSize": { "type": "integer", "minimum": 1 },
        "blockedCidrs": { "type": "array", "items": { "type": "string" } },
        "resources": { "type": "object" }
      }
    },
    "tls": {
      "type": "object",
      "required": ["ca", "duration", "renewBefore"],
      "properties": {
        "ca": {
          "type": "object",
          "required": ["create", "existingIssuer"],
          "properties": {
            "create": { "type": "boolean" },
            "clusterResourceNamespace": { "type": "string", "minLength": 1 },
            "existingIssuer": {
              "type": "object",
              "properties": {
                "name": { "type": "string" },
                "kind": { "type": "string", "enum": ["Issuer", "ClusterIssuer"] }
              }
            }
          }
        },
        "duration": { "type": "string" },
        "renewBefore": { "type": "string" }
      }
    },
    "httpRoute": {
      "type": "object",
      "required": ["enabled", "parentRefs", "hostnames"],
      "properties": {
        "enabled": { "type": "boolean" },
        "parentRefs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name"],
            "properties": { "name": { "type": "string", "minLength": 1 } }
          }
        },
        "hostnames": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      },
      "if": { "properties": { "enabled": { "const": true } } },
      "then": { "properties": { "parentRefs": { "minItems": 1 } } }
    },
    "networkPolicy": {
      "type": "object",
      "required": ["enabled", "ingressController"],
      "properties": {
        "enabled": { "type": "boolean" },
        "ingressController": {
          "type": "object",
          "properties": {
            "allowAll": { "type": "boolean" },
            "namespaceSelector": { "type": "object" },
            "podSelector": { "type": "object" }
          }
        }
      }
    }
  },
  "$defs": {
    "imageRef": {
      "type": "object",
      "required": ["repository", "tag", "digest"],
      "properties": {
        "repository": { "type": "string", "minLength": 1 },
        "tag": { "type": "string" },
        "digest": { "type": "string" }
      }
    },
    "dbRoleSecret": {
      "type": "object",
      "required": ["user", "existingSecret", "passwordKey"],
      "properties": {
        "user": { "type": "string", "minLength": 1 },
        "existingSecret": { "type": "string", "minLength": 1 },
        "passwordKey": { "type": "string", "minLength": 1 }
      }
    }
  }
}
