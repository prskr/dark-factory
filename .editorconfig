root = true

[*]
indent_style = space
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true
max_line_length = 120

[*.{yml,yaml,yml.j2,yaml.j2}]
indent_size = 2
insert_final_newline = true

[*.{sh,bash}]
indent_style = tab
indent_size = 2

[*.rs]
indent_size = 4
max_line_length = 100

[*.{toml,bazel,bzl}]
indent_size = 4

[*.{proto,wit,json}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
