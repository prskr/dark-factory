load("@rules_buf//buf:defs.bzl", "buf_format", "buf_lint_test")
load("@rules_proto//proto:defs.bzl", "proto_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "protos",
    srcs = glob(["proto/**/*.proto"]),
)

filegroup(
    name = "mcp",
    srcs = glob(["mcp/*.json"]),
)

exports_files(["wit/integrations/integrations.wit"])

filegroup(
    name = "wit_integrations",
    srcs = glob(["wit/integrations/**/*.wit"]),
)

proto_library(
    name = "transcript_v1_proto",
    srcs = ["proto/darkfactory/transcript/v1/transcript.proto"],
    strip_import_prefix = "proto",
    deps = ["@protobuf//:timestamp_proto"],
)

proto_library(
    name = "agent_v1_proto",
    srcs = ["proto/darkfactory/agent/v1/agent.proto"],
    strip_import_prefix = "proto",
    deps = [
        ":transcript_v1_proto",
        "@protobuf//:duration_proto",
        "@protobuf//:timestamp_proto",
    ],
)

proto_library(
    name = "gateway_v1_proto",
    srcs = ["proto/darkfactory/gateway/v1/gateway.proto"],
    strip_import_prefix = "proto",
    deps = [
        "@protobuf//:duration_proto",
        "@protobuf//:timestamp_proto",
    ],
)

# Runs on the machine running Bazel: the buf toolchain is downloaded for that host only, so under
# `--config=rbe` from a client that is not amd64 Linux it has no matching execution platform. Such clients
# exclude the tag with `--build_tag_filters=-no-remote-exec` (docs/development.md).
buf_lint_test(
    name = "buf_lint_test",
    config = "proto/buf.yaml",
    tags = ["no-remote-exec"],
    targets = [
        ":agent_v1_proto",
        ":gateway_v1_proto",
        ":transcript_v1_proto",
    ],
)

# `bazel run //contract:format` rewrites the protos in place.
buf_format(
    name = "format",
    tags = ["no-remote-exec"],
)
