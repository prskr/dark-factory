/// Dark Factory integration plugins (D2, D18).
///
/// Plugins are WebAssembly components executed by the control plane. Each
/// plugin exports one or more capability interfaces; the control plane detects
/// which ones by inspecting the component's exports:
///
///   * `pull-requests` — code forges (Forgejo, GitHub, ...)
///   * `issues`        — issue trackers (Forgejo, GitHub, Jira, ...)
///   * `webhooks`      — inbound forge webhooks (world `forge`)
///
/// A forge like Forgejo exports both (world `forge`); an issue-only tracker
/// exports just `issues` (world `issue-provider`).
///
/// Security model:
///   * Plugins reach the network only through `wasi:http/outgoing-handler`.
///     The host links the standard WASI interfaces with no capabilities
///     granted: no preopened directories, no environment, no sockets.
///   * The host allows requests only to the hosts configured for the plugin
///     instance and injects the `Authorization` header itself. Plugins never
///     see credentials; an `Authorization` header set by a plugin is replaced.
///   * Non-secret settings come from `wasi:config/store`.
///   * Webhook secrets stay in the host; plugins check signatures through
///     `webhook-signature.verify`.
///   * Plugins may log to stderr; the host forwards it to its tracing output.
///
/// Configuration keys every integration plugin reads:
///   * `base-url` — e.g. `https://git.example.org`
package darkfactory:integrations@0.1.0;

/// Types shared by all capability interfaces.
interface types {
    /// A repository on the integration's server.
    record repo-ref {
        /// User or organisation, e.g. `peter`.
        owner: string,
        /// Repository name, e.g. `dark-factory`.
        name: string,
    }

    /// Identifies a pull request.
    record pull-request-ref {
        repo: repo-ref,
        number: u64,
    }

    /// Identifies an issue. On forges where pull requests are issues
    /// (Forgejo, GitHub), a pull request number is a valid issue number.
    record issue-ref {
        repo: repo-ref,
        number: u64,
    }

    record rate-limit {
        retry-after-seconds: option<u32>,
        message: string,
    }

    record upstream-error {
        /// HTTP status returned by the upstream server.
        status: u16,
        message: string,
    }

    variant error {
        /// The object doesn't exist or isn't visible to the bot account.
        not-found(string),
        /// Credentials are missing, invalid or lack permission.
        unauthorized(string),
        /// The request conflicts with the current state, e.g. an open pull
        /// request for the same head and base already exists.
        conflict(string),
        /// The input was rejected, e.g. an unknown branch.
        invalid-input(string),
        /// The upstream server asked to slow down.
        rate-limited(rate-limit),
        /// Any other non-success response from the upstream server.
        upstream(upstream-error),
        /// Plugin configuration is missing or invalid.
        config(string),
        /// The upstream server couldn't be reached, or the host denied the
        /// request (destination not allowed).
        transport(string),
        /// A bug in the plugin.
        internal(string),
    }
}

/// Pull requests on a code forge.
interface pull-requests {
    use types.{repo-ref, pull-request-ref, error};

    enum pull-request-state {
        open,
        closed,
        merged,
    }

    record pull-request {
        id: pull-request-ref,
        /// Web URL for humans.
        url: string,
        head: string,
        base: string,
        /// Without any draft marker the forge may add to the title.
        title: string,
        /// Markdown.
        body: string,
        draft: bool,
        state: pull-request-state,
        head-sha: string,
    }

    record new-pull-request {
        repo: repo-ref,
        /// Source branch, e.g. `factory/task/DF-1`.
        head: string,
        /// Target branch, e.g. `main`.
        base: string,
        title: string,
        /// Markdown.
        body: string,
        /// Forges without native drafts emulate them (e.g. Forgejo's
        /// work-in-progress title prefix); the plugin hides that detail.
        draft: bool,
    }

    /// Only fields that are set change.
    record pull-request-update {
        title: option<string>,
        body: option<string>,
        /// `false` marks the pull request ready for review.
        draft: option<bool>,
    }

    /// The author's relationship to the repository.
    enum author-role {
        /// The account that owns the project's forge credential.
        bot,
        /// A user with write access, or the forge's equivalent.
        member,
        /// Anyone else. Their text is untrusted input.
        outside,
    }

    record author {
        login: string,
        role: author-role,
    }

    enum review-verdict {
        approved,
        changes-requested,
        commented,
    }

    /// A top-level comment on the pull request.
    record pr-comment {
        id: string,
        author: author,
        /// Markdown.
        body: string,
        url: string,
        /// RFC 3339.
        created-at: string,
        /// RFC 3339.
        updated-at: string,
    }

    /// A submitted review. Pending reviews are not listed.
    record review {
        id: string,
        author: author,
        verdict: review-verdict,
        /// Markdown, may be empty.
        body: string,
        url: string,
        /// RFC 3339.
        submitted-at: string,
        /// RFC 3339; later than `submitted-at` when the body was edited.
        updated-at: string,
    }

    record review-comment {
        id: string,
        author: author,
        /// Markdown.
        body: string,
        url: string,
        /// RFC 3339.
        created-at: string,
        /// RFC 3339.
        updated-at: string,
    }

    /// Review comments on one place in the diff.
    record review-thread {
        /// Opaque; pass it to `reply`.
        id: string,
        path: string,
        /// `none` for a comment on the whole file.
        line: option<u32>,
        resolved: bool,
        comments: list<review-comment>,
    }

    record feedback {
        comments: list<pr-comment>,
        reviews: list<review>,
        threads: list<review-thread>,
        /// The plugin stopped at a forge listing limit.
        truncated: bool,
    }

    record posted-comment {
        id: string,
        url: string,
    }

    /// Opens a pull request. Fails with `conflict` if an open pull request
    /// for the same head and base exists; callers then use `find-open`.
    create: func(request: new-pull-request) -> result<pull-request, error>;

    /// The open pull request from `head` into `base`, if any. Makes creation
    /// idempotent and supports attaching tasks to existing pull requests.
    find-open: func(repo: repo-ref, head: string, base: string) -> result<option<pull-request>, error>;

    /// Which open pull requests `list-open` returns. All set fields apply together.
    record open-filter {
        /// Head branch in the repository itself; pull requests from forks never match.
        head: string,
        /// Not supported yet: plugins return `invalid-input` when set (`iter3-ci-tools`).
        head-prefix: option<string>,
        /// Not supported yet, see `head-prefix`.
        author: option<string>,
        /// Not supported yet, see `head-prefix`.
        label: option<string>,
        /// Not supported yet, see `head-prefix`.
        base: option<string>,
    }

    /// Open pull requests of the repository that match `filter`, following the forge's
    /// pagination. Unlike `find-open` it needs no base branch.
    list-open: func(repo: repo-ref, filter: open-filter) -> result<list<pull-request>, error>;

    get: func(id: pull-request-ref) -> result<pull-request, error>;

    update: func(id: pull-request-ref, changes: pull-request-update) -> result<pull-request, error>;

    /// PR comments, reviews and review threads. With `since` (RFC 3339) only
    /// PR comments and reviews created or updated at or after it, and threads
    /// with at least one such review comment, each with all its comments.
    /// Top-level PR comments are posted with `issues.add-comment`.
    list-feedback: func(id: pull-request-ref, since: option<string>) -> result<feedback, error>;

    /// Replies in a review thread. `thread` is an id from `list-feedback`
    /// for the same pull request; any other id yields `invalid-input` or
    /// `not-found`. Not idempotent: the host only retries when the error is
    /// `rate-limited` or `transport` and accepts rare duplicates.
    reply: func(id: pull-request-ref, thread: string, body: string) -> result<posted-comment, error>;
}

/// Issues in an issue tracker.
interface issues {
    use types.{issue-ref, error};

    enum issue-state {
        open,
        closed,
    }

    record issue {
        id: issue-ref,
        /// Web URL for humans.
        url: string,
        title: string,
        /// Markdown.
        body: string,
        state: issue-state,
        labels: list<string>,
    }

    record comment {
        /// Tracker-specific identifier.
        id: string,
        url: string,
    }

    get: func(id: issue-ref) -> result<issue, error>;

    /// Adds a Markdown comment. Not idempotent: the host only retries when
    /// the error is `rate-limited` or `transport` and accepts rare duplicates.
    add-comment: func(id: issue-ref, body: string) -> result<comment, error>;
}

/// Imported by plugins: checks a webhook signature; the secret stays in the host.
interface webhook-signature {
    /// True if `signature` equals HMAC-SHA256(secret, raw body) of the webhook being handled,
    /// compared in constant time. False outside `webhooks.handle-webhook`.
    verify: func(signature: list<u8>) -> bool;
}

/// Inbound forge webhooks, normalized to the few events the control plane acts on.
interface webhooks {
    use types.{repo-ref, pull-request-ref, issue-ref, error};
    // Renamed: the function `author-role` below takes the name.
    use pull-requests.{author-role as role, review-verdict};

    /// A submitted review; a single review comment the forge publishes at once counts as one.
    record review-submitted {
        pr: pull-request-ref,
        /// Head branch of the pull request.
        head: string,
        actor: string,
        verdict: review-verdict,
    }

    record pull-request-closed {
        pr: pull-request-ref,
        head: string,
        actor: string,
        merged: bool,
    }

    record ci-failed {
        repo: repo-ref,
        /// Branch the failed run or check belongs to.
        head: string,
        /// Check, workflow or status context name.
        check: string,
        /// Web URL of the failed run, may be empty.
        url: string,
    }

    /// A new comment on an issue or pull request. No comment text crosses the boundary.
    record comment-created {
        issue: issue-ref,
        is-pull-request: bool,
        actor: string,
        /// Logins mentioned with the forge's mention syntax.
        mentions: list<string>,
    }

    variant webhook-event {
        review-submitted(review-submitted),
        pull-request-closed(pull-request-closed),
        ci-failed(ci-failed),
        comment-created(comment-created),
    }

    record parsed-event {
        /// Web URL of the repository the payload names.
        repo-url: string,
        event: webhook-event,
    }

    /// Parses one delivery after checking its signature with `webhook-signature.verify`.
    /// Unknown events yield an empty list; a malformed payload yields `invalid-input`.
    /// Runs without network access.
    handle-webhook: func(headers: list<tuple<string, string>>, body: list<u8>) -> result<list<parsed-event>, error>;

    /// Login of the account owning the credential.
    whoami: func() -> result<string, error>;

    /// `login`'s relationship to `repo`.
    author-role: func(repo: repo-ref, login: string) -> result<role, error>;
}

/// What every integration plugin may import.
world plugin-base {
    import wasi:http/outgoing-handler@0.2.12;
    import wasi:config/store@0.2.0-rc.1;
    import wasi:clocks/monotonic-clock@0.2.12;
    import wasi:clocks/wall-clock@0.2.12;
    import wasi:random/random@0.2.12;
    import wasi:random/insecure-seed@0.2.12; // seeds std's HashMap on musl/Bazel builds
    import wasi:cli/stderr@0.2.12;
    // Rust std on wasm32-wasip2 imports these; the host grants no files, arguments or terminals.
    import wasi:cli/environment@0.2.12;
    import wasi:cli/exit@0.2.12;
    import wasi:cli/stdin@0.2.12;
    import wasi:cli/stdout@0.2.12;
    import wasi:cli/terminal-input@0.2.12;
    import wasi:cli/terminal-output@0.2.12;
    import wasi:cli/terminal-stdin@0.2.12;
    import wasi:cli/terminal-stdout@0.2.12;
    import wasi:cli/terminal-stderr@0.2.12;
    import webhook-signature;
}

world pull-request-provider {
    include plugin-base;
    export pull-requests;
}

world issue-provider {
    include plugin-base;
    export issues;
}

/// A code forge that also hosts issues and receives webhooks, e.g. Forgejo.
world forge {
    include pull-request-provider;
    include issue-provider;
    export webhooks;
}
