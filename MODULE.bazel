    executable = True,
    sha256 = "1a3c33590eada49e9658c72f1f2946b04afe897149c98512e4563e39ed1ac1c0",
    urls = ["https://github.com/tailwindlabs/tailwindcss/releases/download/v4.1.4/tailwindcss-linux-arm64-musl"],
)

http_file(
    name = "tailwindcss_linux_x64",
    downloaded_file_path = "tailwindcss",
    executable = True,
    sha256 = "85c31481ace4c66071c8ec4e05164e7a67baecb0454955160925caf2611849f0",
    urls = ["https://github.com/tailwindlabs/tailwindcss/releases/download/v4.1.4/tailwindcss-linux-x64-musl"],
