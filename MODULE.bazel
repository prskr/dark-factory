"""Dark Factory Bazel module."""

module(
    name = "dark_factory",
    version = "0.1.0",
)

# Keep in sync with `channel` in rust-toolchain.toml (a module file cannot read it).
RUST_VERSION = "1.99.1"

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "aspect_rules_js", version = "3.5.2")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "35.1")
bazel_dep(name = "rules_cc", version = "0.2.27")

bazel_dep(name = "rules_buf", version = "0.5.4", dev_dependency = True)

bazel_dep(name = "rules_img", version = "0.3.23")
bazel_dep(name = "rules_multirun", version = "0.14.0")
bazel_dep(name = "rules_multitool", version = "1.11.1")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "tar.bzl", version = "0.10.7")

bazel_dep(name = "bazel_env.bzl", version = "0.10.0", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
bazel_dep(name = "toolchains_musl", version = "0.1.29", dev_dependency = True)

# Every Linux target is static musl (see docs/development.md). Exec tools (build scripts, proc-macros)
# use the host's C toolchain.
toolchains_musl = use_extension("@toolchains_musl//:toolchains_musl.bzl", "toolchains_musl", dev_dependency = True)
toolchains_musl.config(
    extra_target_compatible_with = ["//build/platforms:musl"],
)
use_repo(toolchains_musl, "musl_toolchains_hub")

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf", dev_dependency = True)
buf.toolchains(version = "v1.68.4")
use_repo(buf, "rules_buf_toolchains")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_rustc_flags_triples = {
        "aarch64-unknown-linux-musl": ["-Ctarget-feature=+crt-static"],
        "x86_64-unknown-linux-musl": ["-Ctarget-feature=+crt-static"],
    },
    extra_target_triples = [
        "wasm32-wasip2",
    ],
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_macos_aarch64",
    edition = "2024",
    exec_triple = "aarch64-apple-darwin",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "//build/platforms:musl",
    ],
    target_triple = "x86_64-unknown-linux-musl",
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_macos_aarch64",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "//build/platforms:musl",
    ],
    target_triple = "aarch64-unknown-linux-musl",
)
rust.repository_set(
    name = "rust_macos_aarch64",
    target_compatible_with = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
        "@rules_rust//rust/platform:wasi_preview_2",
    ],
    target_triple = "wasm32-wasip2",
)
rust.repository_set(
    name = "rust_linux_aarch64",
    edition = "2024",
    exec_triple = "aarch64-unknown-linux-gnu",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "//build/platforms:musl",
    ],
    target_triple = "x86_64-unknown-linux-musl",
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_linux_aarch64",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "//build/platforms:musl",
    ],
    target_triple = "aarch64-unknown-linux-musl",
)
rust.repository_set(
    name = "rust_linux_aarch64",
    target_compatible_with = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
        "@rules_rust//rust/platform:wasi_preview_2",
    ],
    target_triple = "wasm32-wasip2",
)
rust.repository_set(
    name = "rust_linux_x86_64",
    edition = "2024",
    exec_triple = "x86_64-unknown-linux-gnu",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "//build/platforms:musl",
    ],
    target_triple = "x86_64-unknown-linux-musl",
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_linux_x86_64",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "//build/platforms:musl",
    ],
    target_triple = "aarch64-unknown-linux-musl",
)
rust.repository_set(
    name = "rust_linux_x86_64",
    target_compatible_with = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
        "@rules_rust//rust/platform:wasi_preview_2",
    ],
    target_triple = "wasm32-wasip2",
)
use_repo(rust, "rust_toolchains")

# Registration order decides: the default `*-unknown-linux-gnu` toolchains (cpu + os only) also match the
# musl platforms and would link glibc libstd with musl-gcc, so the musl ones come first.
register_toolchains(
    "@musl_toolchains_hub//:all",
    "//build/platforms:musl_test_toolchain",
    dev_dependency = True,
)

register_toolchains(
    "@rust_toolchains//:rust_linux_x86_64__x86_64-unknown-linux-musl__stable",
    "@rust_toolchains//:rust_linux_x86_64__aarch64-unknown-linux-musl__stable",
    "@rust_toolchains//:rust_linux_aarch64__x86_64-unknown-linux-musl__stable",
    "@rust_toolchains//:rust_linux_aarch64__aarch64-unknown-linux-musl__stable",
    "@rust_toolchains//:rust_macos_aarch64__x86_64-unknown-linux-musl__stable",
    "@rust_toolchains//:rust_macos_aarch64__aarch64-unknown-linux-musl__stable",
    "@rust_toolchains//:all",
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//crates/dark-factory:Cargo.toml",
        "//crates/df-agent-channel:Cargo.toml",
        "//crates/df-core:Cargo.toml",
        "//crates/df-db:Cargo.toml",
        "//crates/df-gateway:Cargo.toml",
        "//crates/df-harness:Cargo.toml",
        "//crates/df-k8s:Cargo.toml",
        "//crates/df-plugins:Cargo.toml",
        "//crates/df-proto:Cargo.toml",
        "//crates/df-telemetry:Cargo.toml",
        "//crates/df-test-postgres:Cargo.toml",
        "//crates/df-web:Cargo.toml",
        "//crates/factory-agent:Cargo.toml",
        "//crates/fake-acp-agent:Cargo.toml",
        "//plugins/forgejo:Cargo.toml",
        "//plugins/github:Cargo.toml",
        "//plugins/test-probe:Cargo.toml",
    ],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        # also used for the musl platforms: rules_rust maps a triple to cpu + os and does not model musl
        "aarch64-unknown-linux-gnu",
        "wasm32-wasip2",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

# Linter binaries; regenerate the lock with `cargo xtask update-tools`.
multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//:multitool.lock.json")
use_repo(multitool, "multitool")

# Vendored schemas so kubeconform never touches the network.
git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "k8s_json_schema",
    build_file_content = """exports_files(["_definitions.json"])

filegroup(
    name = "schemas",
    srcs = glob(["**/*.json"]),
    visibility = ["//visibility:public"],
)""",
    commit = "aff1ca44984cbbcfa376c1cb6fdc4bb6aa0381fd",
    remote = "https://github.com/yannh/kubernetes-json-schema.git",
    sparse_checkout_patterns = ["v1.34.3-standalone-strict"],
    strip_prefix = "v1.34.3-standalone-strict",
)

git_repository(
    name = "crds_catalog",
    build_file_content = """exports_files(["cert-manager.io/certificate_v1.json"])

filegroup(
    name = "schemas",
    srcs = glob(["**/*.json"]),
    visibility = ["//visibility:public"],
)""",
    commit = "3eb90d47aba8d61919d4419dd38301536e32a94b",
    remote = "https://github.com/datreeio/CRDs-catalog.git",
    sparse_checkout_patterns = ["cert-manager.io"],
)

pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "distroless_static_debian13_nonroot",
    digest = "sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3",
    # Bazel downloader: blobs land in the repository cache (sha256-addressed) and are not fetched again.
    downloader = "bazel",
    # Only the platforms the images are built for; every child manifest counts as a registry pull.
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
    registry = "gcr.io",
    repository = "distroless/static-debian13",
)

pull(
    name = "debian_trixie_git",
    digest = "sha256:880a5e3d451b50a7b1acd06093a980771a40c2fac2bce29a2145e0f4825266f4",
    downloader = "bazel",
    platforms = [
        "linux/amd64",
        "linux/arm64",
    ],
    registry = "mirror.gcr.io",
    repository = "library/buildpack-deps",
)

# Claude harness image (deploy/images/claude-harness): the ACP adapter and its npm dependencies from
# the pnpm lockfile, Node.js from the unofficial musl builds and the musl runtime libraries (loader,
# libstdc++, libgcc_s) from the Bootlin toolchains. Node's libstdc++ needs GCC >= 13, so the GCC 11
# sysroot of toolchains_musl does not do.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "npm_claude_harness",
    pnpm_lock = "//deploy/images/claude-harness:pnpm-lock.yaml",
    # the native Claude Code CLI of each architecture, at a version-free label
    public_hoist_packages = {
        "@anthropic-ai/claude-agent-sdk-linux-arm64-musl": ["deploy/images/claude-harness"],
        "@anthropic-ai/claude-agent-sdk-linux-x64-musl": ["deploy/images/claude-harness"],
    },
)
use_repo(npm, "npm_claude_harness")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

NODE_VERSION = "v24.22.2"

NODE_BUILD = 'exports_files(["bin/node"], visibility = ["//visibility:public"])'

http_archive(
    name = "node_linux_amd64_musl",
    build_file_content = NODE_BUILD,
    sha256 = "dfee3453f0557e77dfbd8f8b1c981cd7320dd6bf4e799abe007c12e8c1ab3b54",
    strip_prefix = "node-{0}-linux-x64-musl".format(NODE_VERSION),
    url = "https://unofficial-builds.nodejs.org/download/release/{0}/node-{0}-linux-x64-musl.tar.xz".format(NODE_VERSION),
)

http_archive(
    name = "node_linux_arm64_musl",
    build_file_content = NODE_BUILD,
    sha256 = "73be937844e8b6a0199e0a9554863f7afdbcab39da7cf5edbd8e83a7001ef4fc",
    strip_prefix = "node-{0}-linux-arm64-musl".format(NODE_VERSION),
    url = "https://unofficial-builds.nodejs.org/download/release/{0}/node-{0}-linux-arm64-musl.tar.xz".format(NODE_VERSION),
)

BOOTLIN_RELEASE = "stable-2026.08-1"

MUSL_RUNTIME_BUILD = 'exports_files(["lib/libc.so", "lib/libgcc_s.so.1", "usr/lib/libstdc++.so.6"], visibility = ["//visibility:public"])'

http_archive(
    name = "musl_runtime_linux_amd64",
    build_file_content = MUSL_RUNTIME_BUILD,
    sha256 = "78d3a4683d6ac47b5ee73bd5bce210b55eb93dff1b137c61298af97eb0d2b5a6",
    strip_prefix = "x86-64--musl--{0}/x86_64-buildroot-linux-musl/sysroot".format(BOOTLIN_RELEASE),
    url = "https://toolchains.bootlin.com/downloads/releases/toolchains/x86-64/tarballs/x86-64--musl--{0}.tar.xz".format(BOOTLIN_RELEASE),
)

http_archive(
    name = "musl_runtime_linux_arm64",
    build_file_content = MUSL_RUNTIME_BUILD,
    sha256 = "b388c480a48e8e9f9b99e3d14e69219c4d61e5a2424a82faecb88a015b781a60",
    strip_prefix = "aarch64--musl--{0}/aarch64-buildroot-linux-musl/sysroot".format(BOOTLIN_RELEASE),
    url = "https://toolchains.bootlin.com/downloads/releases/toolchains/aarch64/tarballs/aarch64--musl--{0}.tar.xz".format(BOOTLIN_RELEASE),
)
