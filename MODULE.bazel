"""Dark Factory Bazel module."""

module(
    name = "dark_factory",
    version = "0.1.0",
)

# Keep in sync with `channel` in rust-toolchain.toml (a module file cannot read it).
RUST_VERSION = "1.99.1"

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "protobuf", version = "35.1")

bazel_dep(name = "rules_buf", version = "0.5.4", dev_dependency = True)

bazel_dep(name = "rules_img", version = "0.3.23")
bazel_dep(name = "rules_multirun", version = "0.14.0")
bazel_dep(name = "rules_multitool", version = "1.11.1")
bazel_dep(name = "rules_pkg", version = "1.2.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "rules_rust", version = "0.73.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "tar.bzl", version = "0.10.7")

bazel_dep(name = "bazel_env.bzl", version = "0.10.0", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
bazel_dep(name = "toolchains_llvm", version = "1.11.3", dev_dependency = True)
bazel_dep(name = "toolchains_musl", version = "0.1.29", dev_dependency = True)

toolchains_musl = use_extension("@toolchains_musl//:toolchains_musl.bzl", "toolchains_musl", dev_dependency = True)
toolchains_musl.config(
    extra_target_compatible_with = ["//build/platforms:musl"],
)
use_repo(toolchains_musl, "musl_toolchains_hub")

# Hermetic glibc C/C++ toolchain for Linux exec tools (build scripts, protoc plugins) on the
# remote workers. Sysroots are the Debian Bullseye ones from rules_rust's cross_compile_llvm example.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "sysroot_linux_x64",
    build_file_content = """filegroup(
    name = "sysroot",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)""",
    dev_dependency = True,
    sha256 = "5df5be9357b425cdd70d92d4697d07e7d55d7a923f037c22dc80a78e85842d2c",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/toolchain/4f611ec025be98214164d4bf9fbe8843f58533f7/debian_bullseye_amd64_sysroot.tar.xz"],
)

http_archive(
    name = "sysroot_linux_aarch64",
    build_file_content = """filegroup(
    name = "sysroot",
    srcs = glob(["**"]),
    visibility = ["//visibility:public"],
)""",
    dev_dependency = True,
    sha256 = "d303cf3faf7804c9dd24c9b6b167d0345d41d7fe4bfb7d34add3ab342f6a236c",
    urls = ["https://commondatastorage.googleapis.com/chrome-linux-sysroot/toolchain/906cc7c6bf47d4bd969a3221fc0602c6b3153caa/debian_bullseye_arm64_sysroot.tar.xz"],
)

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.toolchain(
    name = "llvm_toolchain",
    # Run on the Linux RBE workers even when Bazel itself runs on macOS.
    exec_arch = "amd64",
    exec_os = "linux",
    # rules_rust links exec tools with rust-lld directly, which knows no default library directories.
    # `-L=` is relative to the `--sysroot` that rules_rust takes from the cc toolchain.
    extra_link_flags = {
        "linux-aarch64": [
            "-L=/usr/lib/aarch64-linux-gnu",
            "-L=/lib/aarch64-linux-gnu",
            "-L=/usr/lib/gcc/aarch64-linux-gnu/10",
        ],
        "linux-x86_64": [
            "-L=/usr/lib/x86_64-linux-gnu",
            "-L=/lib/x86_64-linux-gnu",
            "-L=/usr/lib/gcc/x86_64-linux-gnu/10",
        ],
    },
    llvm_version = "23.1.3",
    stdlib = {
        "linux-aarch64": "stdc++",
        "linux-x86_64": "stdc++",
    },
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_x64//:sysroot",
    targets = ["linux-x86_64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_aarch64//:sysroot",
    targets = ["linux-aarch64"],
)
use_repo(llvm, "llvm_toolchain")

register_toolchains(
    "@llvm_toolchain//:all",
    dev_dependency = True,
)

buf = use_extension("@rules_buf//buf:extensions.bzl", "buf", dev_dependency = True)
buf.toolchains(version = "v1.68.4")
use_repo(buf, "rules_buf_toolchains")

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust")
rust.toolchain(
    edition = "2024",
    extra_rustc_flags_triples = {
        "aarch64-unknown-linux-musl": ["-Ctarget-feature=+crt-static"],
        "x86_64-unknown-linux-musl": ["-Ctarget-feature=+crt-static"],
    },
    extra_target_triples = [
        "wasm32-wasip2",
    ],
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_macos_aarch64",
    edition = "2024",
    exec_triple = "aarch64-apple-darwin",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "//build/platforms:musl",
    ],
    target_triple = "x86_64-unknown-linux-musl",
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_macos_aarch64",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "//build/platforms:musl",
    ],
    target_triple = "aarch64-unknown-linux-musl",
)
rust.repository_set(
    name = "rust_macos_aarch64",
    target_compatible_with = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
        "@rules_rust//rust/platform:wasi_preview_2",
    ],
    target_triple = "wasm32-wasip2",
)
rust.repository_set(
    name = "rust_linux_aarch64",
    edition = "2024",
    exec_triple = "aarch64-unknown-linux-gnu",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "//build/platforms:musl",
    ],
    target_triple = "x86_64-unknown-linux-musl",
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_linux_aarch64",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "//build/platforms:musl",
    ],
    target_triple = "aarch64-unknown-linux-musl",
)
rust.repository_set(
    name = "rust_linux_aarch64",
    target_compatible_with = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
        "@rules_rust//rust/platform:wasi_preview_2",
    ],
    target_triple = "wasm32-wasip2",
)
rust.repository_set(
    name = "rust_linux_x86_64",
    edition = "2024",
    exec_triple = "x86_64-unknown-linux-gnu",
    target_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
        "//build/platforms:musl",
    ],
    target_triple = "x86_64-unknown-linux-musl",
    versions = [RUST_VERSION],
)
rust.repository_set(
    name = "rust_linux_x86_64",
    target_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
        "//build/platforms:musl",
    ],
    target_triple = "aarch64-unknown-linux-musl",
)
rust.repository_set(
    name = "rust_linux_x86_64",
    target_compatible_with = [
        "@platforms//cpu:wasm32",
        "@platforms//os:wasi",
        "@rules_rust//rust/platform:wasi_preview_2",
    ],
    target_triple = "wasm32-wasip2",
)
use_repo(rust, "rust_toolchains")

register_toolchains("@rust_toolchains//:all")

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    manifests = [
        "//:Cargo.toml",
        "//crates/dark-factory:Cargo.toml",
        "//crates/df-core:Cargo.toml",
        "//crates/df-db:Cargo.toml",
        "//crates/df-proto:Cargo.toml",
        "//crates/df-web:Cargo.toml",
        "//crates/factory-agent:Cargo.toml",
        "//crates/fake-acp-agent:Cargo.toml",
        "//plugins/forgejo:Cargo.toml",
    ],
    supported_platform_triples = [
        "aarch64-apple-darwin",
        "aarch64-unknown-linux-gnu",
        "wasm32-wasip2",
        "x86_64-unknown-linux-gnu",
    ],
)
use_repo(crate, "crates")

# Linter binaries; regenerate the lock with `cargo xtask update-tools`.
multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(lockfile = "//:multitool.lock.json")
use_repo(multitool, "multitool")

# Vendored schemas so kubeconform never touches the network.
git_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:git.bzl", "git_repository")

git_repository(
    name = "k8s_json_schema",
    build_file_content = """exports_files(["_definitions.json"])

filegroup(
    name = "schemas",
    srcs = glob(["**/*.json"]),
    visibility = ["//visibility:public"],
)""",
    commit = "aff1ca44984cbbcfa376c1cb6fdc4bb6aa0381fd",
    remote = "https://github.com/yannh/kubernetes-json-schema.git",
    sparse_checkout_patterns = ["v1.34.3-standalone-strict"],
    strip_prefix = "v1.34.3-standalone-strict",
)

git_repository(
    name = "crds_catalog",
    build_file_content = """exports_files(["cert-manager.io/certificate_v1.json"])

filegroup(
    name = "schemas",
    srcs = glob(["**/*.json"]),
    visibility = ["//visibility:public"],
)""",
    commit = "d373c2da9702bc9509a004db83e57263fe3bdfc1",
    remote = "https://github.com/datreeio/CRDs-catalog.git",
    sparse_checkout_patterns = ["cert-manager.io"],
)

pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "distroless_static_debian13_nonroot",
    digest = "sha256:e2e927ec666bae08560abb3c55d0659eceabb657f56b6782ab500a9fc7f555e3",
    registry = "gcr.io",
    repository = "distroless/static-debian13",
)

pull(
    name = "debian_trixie_git",
    digest = "sha256:4241005cb2c47ea99750627baeb06714f6fde7f01a69ce451d85f8dccf0f5691",
    registry = "public.ecr.aws",
    repository = "docker/library/buildpack-deps",
)
