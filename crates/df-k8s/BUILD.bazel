load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

exports_files(["Cargo.toml"])

rust_library(
    name = "df_k8s",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "df_k8s",
    edition = "2024",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//crates/df-core",
        "//crates/df-telemetry",
    ],
)

alias(
    name = "df-k8s",
    actual = ":df_k8s",
)

# Rebuilt from source (instead of `crate = ":df_k8s"`) so that the tests can use the `test-util`
# variant of `df-telemetry` (log capture) without the library linking it.
rust_test(
    name = "df_k8s_test",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    # render.rs tests check the sandbox env against the runtime's configuration reference;
    # the provider tests load recorded kubelet events and pods.
    compile_data = ["//crates/factory-agent:docs/configuration.md"] + glob(["src/provider/fixtures/*.json"]),
    crate_name = "df_k8s",
    crate_root = "src/lib.rs",
    data = glob(["src/**/snapshots/*.snap"]),
    edition = "2024",
    env = {
        "INSTA_UPDATE": "no",
        "INSTA_WORKSPACE_ROOT": ".",
    },
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        "//crates/df-core",
        "//crates/df-telemetry:df_telemetry_test_util",
    ],
)
