load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "df_k8s",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_name = "df_k8s",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//crates/df-core",
        "//crates/df-telemetry",
    ],
)

alias(
    name = "df-k8s",
    actual = ":df_k8s",
)

rust_test(
    name = "df_k8s_test",
    # render.rs tests check the sandbox env against the runtime's configuration reference.
    compile_data = ["//crates/factory-agent:docs/configuration.md"],
    crate = ":df_k8s",
    data = glob(["src/snapshots/*.snap"]),
    env = {
        "INSTA_UPDATE": "no",
        "INSTA_WORKSPACE_ROOT": ".",
    },
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/df-core",
        "//crates/df-telemetry",
    ],
)
