---
source: crates/df-k8s/src/render.rs
expression: sandbox
---
apiVersion: agents.x-k8s.io/v1beta1
kind: Sandbox
metadata:
  labels:
    app.kubernetes.io/managed-by: dark-factory
    dark-factory.io/instance: test-instance
    dark-factory.io/persona: 00000000-0000-0000-0000-000000000014
    dark-factory.io/project: DF
    dark-factory.io/run-id: 00000000-0000-0000-0000-000000000001
    dark-factory.io/task-key: DF-1
  name: run-df-1-1
  namespace: dark-factory-dev-sandboxes
spec:
  operatingMode: Running
  podTemplate:
    metadata:
      labels:
        app.kubernetes.io/managed-by: dark-factory
        dark-factory.io/instance: test-instance
        dark-factory.io/persona: 00000000-0000-0000-0000-000000000014
        dark-factory.io/project: DF
        dark-factory.io/run-id: 00000000-0000-0000-0000-000000000001
        dark-factory.io/task-key: DF-1
    spec:
      automountServiceAccountToken: false
      containers:
        - command:
            - /opt/factory/factory-agent
            - run
          env:
            - name: HTTP_PROXY
              value: "http://10.105.68.86:3128"
            - name: HTTPS_PROXY
              value: "http://10.105.68.86:3128"
            - name: http_proxy
              value: "http://10.105.68.86:3128"
            - name: https_proxy
              value: "http://10.105.68.86:3128"
            - name: NO_PROXY
              value: "10.103.178.202,scheduler.nativelink.svc.cluster.local,scheduler.nativelink.svc,10.96.0.50"
            - name: no_proxy
              value: "10.103.178.202,scheduler.nativelink.svc.cluster.local,scheduler.nativelink.svc,10.96.0.50"
            - name: DF_CONTROL_PLANE_ADDR
              value: "10.103.178.202:9443"
            - name: DF_CONTROL_PLANE_SERVER_NAME
              value: dark-factory-control-plane.dark-factory-dev.svc
            - name: DF_LOG_FORMAT
              value: text
            - name: RUST_LOG
              value: info
          image: "test-project:latest"
          name: agent
          securityContext:
            allowPrivilegeEscalation: false
            capabilities:
              drop:
                - ALL
          volumeMounts:
            - mountPath: /opt/factory
              name: factory-runtime
              readOnly: true
            - mountPath: /run/factory/tls
              name: tls
              readOnly: true
            - mountPath: /data
              name: task-data
            - mountPath: /run/factory
              name: tmpfs
      hostAliases:
        - hostnames:
            - scheduler.nativelink.svc.cluster.local
            - scheduler.nativelink.svc
          ip: 10.96.0.50
      runtimeClassName: kata
      securityContext:
        fsGroup: 1000
        runAsGroup: 1000
        runAsNonRoot: true
        runAsUser: 1000
        seccompProfile:
          type: RuntimeDefault
      serviceAccountName: dark-factory-sandbox
      volumes:
        - image:
            pullPolicy: IfNotPresent
            reference: "ghcr.io/prskr/dark-factory/runtime:dev"
          name: factory-runtime
        - csi:
            driver: csi.cert-manager.io
            readOnly: true
            volumeAttributes:
              csi.cert-manager.io/duration: 6h
              csi.cert-manager.io/issuer-group: cert-manager.io
              csi.cert-manager.io/issuer-kind: ClusterIssuer
              csi.cert-manager.io/issuer-name: dark-factory-ca-issuer
              csi.cert-manager.io/renew-before: 2h
              csi.cert-manager.io/uri-sans: "spiffe://dark-factory/ns/${POD_NAMESPACE}/pod/${POD_NAME}/${POD_UID}"
          name: tls
        - name: task-data
          persistentVolumeClaim:
            claimName: task-df-1
        - emptyDir:
            medium: Memory
          name: tmpfs
  shutdownPolicy: Retain
