load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

exports_files(["Cargo.toml"])

rust_library(
    name = "df_plugins",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["//contract:wit_integrations"],
    crate_name = "df_plugins",
    edition = "2024",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//crates/df-core:df_core",
    ],
)

alias(
    name = "df-plugins",
    actual = ":df_plugins",
)

rust_test(
    name = "df_plugins_test",
    crate = ":df_plugins",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal_dev = True) + [
        "//crates/df-core:df_core",
    ],
)

# Integration tests run the plugin components built by Bazel (without the variables they build
# them with cargo). `image_component` loads the optimized component that goes into the plugin image.
FORGEJO = "//plugins/forgejo"

GITHUB = "//plugins/github"

PROBE = "//plugins/test-probe"

IMAGE_FORGEJO = "//deploy:forgejo_plugin"

IMAGE_GITHUB = "//deploy:github_plugin"

# `tests/github.rs` checks the mock traffic against the OpenAPI extract (`tests/github_openapi`).
EXTRAS = {
    "github": {
        "compile_data": ["//plugins/github:tests/fixtures/github-openapi.json"],
        "srcs": glob(["tests/github_openapi/**/*.rs"]),
    },
}

[
    rust_test(
        name = "df_plugins_%s_test" % name,
        srcs = ["tests/%s.rs" % name] + glob(["tests/common/**/*.rs"]) +
               EXTRAS.get(name, {}).get("srcs", []),
        compile_data = EXTRAS.get(name, {}).get("compile_data", []),
        crate_root = "tests/%s.rs" % name,
        data = components.values(),
        edition = "2024",
        env = {var: "$(rootpath %s)" % label for var, label in components.items()},
        lint_config = ":lints",
        proc_macro_deps = all_crate_deps(
            proc_macro = True,
            proc_macro_dev = True,
        ),
        deps = all_crate_deps(
            normal = True,
            normal_dev = True,
        ) + [
            ":df_plugins",
            "//crates/df-core:df_core",
        ],
    )
    for name, components in {
        "forgejo": {
            "FORGEJO_PLUGIN_WASM": FORGEJO,
            "TEST_PROBE_WASM": PROBE,
        },
        "github": {"GITHUB_PLUGIN_WASM": GITHUB},
        "github_live": {"GITHUB_PLUGIN_WASM": GITHUB},
        "homelab": {
            "FORGEJO_PLUGIN_WASM": FORGEJO,
            "TEST_PROBE_WASM": PROBE,
        },
        "image_component": {
            "FORGEJO_PLUGIN_WASM": IMAGE_FORGEJO,
            "GITHUB_PLUGIN_WASM": IMAGE_GITHUB,
        },
        "load": {
            "FORGEJO_PLUGIN_WASM": FORGEJO,
            "GITHUB_PLUGIN_WASM": GITHUB,
            "TEST_PROBE_WASM": PROBE,
        },
        "routing": {
            "FORGEJO_PLUGIN_WASM": FORGEJO,
            "TEST_PROBE_WASM": PROBE,
        },
        "sandbox": {
            "FORGEJO_PLUGIN_WASM": FORGEJO,
            "TEST_PROBE_WASM": PROBE,
        },
    }.items()
]
