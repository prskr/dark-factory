load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

exports_files(["Cargo.toml"])

rust_library(
    name = "df_gateway",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["rules/secrets.yml"],
    crate_name = "df_gateway",
    edition = "2024",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//crates/df-core:df_core",
        "//crates/df-proto:df_proto",
        "//crates/df-sandbox-contract:df_sandbox_contract",
        "//crates/df-telemetry:df_telemetry",
        "//crates/df-tls:df_tls",
    ],
)

alias(
    name = "df-gateway",
    actual = ":df_gateway",
)

# Same crate with the feature `test-util` (`link::PlainConnector`) on the `test-util` variants of
# `df-tls` and `df-telemetry`, for tests of crates that also link those variants (`dark-factory`,
# `df-gateway-control`): both must see one `TlsPaths`, `LogFormat` and `GrpcConnector`.
rust_library(
    name = "df_gateway_test_util",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["rules/secrets.yml"],
    crate_features = ["test-util"],
    crate_name = "df_gateway",
    edition = "2024",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    visibility = ["//crates:__subpackages__"],
    deps = all_crate_deps(normal = True) + [
        "//crates/df-core:df_core",
        "//crates/df-proto:df_proto",
        "//crates/df-sandbox-contract:df_sandbox_contract",
        "//crates/df-telemetry:df_telemetry_test_util",
        "//crates/df-tls:df_tls_test_util",
    ],
)

# Rebuilt from source (instead of `crate = ":df_gateway"`) so that the tests can use the
# `test-util` variants of `df-tls` (test PKI) and `df-telemetry` (log capture, metric probe)
# without the library linking them.
rust_test(
    name = "df_gateway_test",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["rules/secrets.yml"],
    crate_name = "df_gateway",
    crate_root = "src/lib.rs",
    edition = "2024",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        "//crates/df-core:df_core",
        "//crates/df-proto:df_proto",
        "//crates/df-sandbox-contract:df_sandbox_contract",
        "//crates/df-telemetry:df_telemetry_test_util",
        "//crates/df-tls:df_tls_test_util",
    ],
)

