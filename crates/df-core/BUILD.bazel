load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

exports_files([
    "Cargo.toml",
    "testdata/opencode-config.json",
])

rust_library(
    name = "df_core",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["test-util"],
    crate_name = "df_core",
    edition = "2024",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + ["//crates/df-artifact-types:df_artifact_types"],
)

alias(
    name = "df-core",
    actual = ":df_core",
)

rust_test(
    name = "df_core_test",
    # `lifecycle` compares its event types with the Helm values schema
    compile_data = [
        "docs/task-transitions.md",
        "testdata/opencode-config.json",
        "//deploy:helm/dark-factory/values.schema.json",
    ],
    crate = ":df_core",
    crate_features = ["test-util"],
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal_dev = True) + ["//crates/df-artifact-types:df_artifact_types"],
)
