load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

exports_files(["Cargo.toml"])

rust_binary(
    name = "dark-factory",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    edition = "2024",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//crates/df-agent-channel:df_agent_channel",
        "//crates/df-core:df_core",
        "//crates/df-db:df_db",
        "//crates/df-gateway:df_gateway",
        "//crates/df-k8s:df_k8s",
        "//crates/df-plugins:df_plugins",
        "//crates/df-proto:df_proto",
        "//crates/df-telemetry:df_telemetry",
        "//crates/df-web:df_web",
    ],
)

# The Cargo feature `dev-tools` (development flags such as `--unrestricted-project-subscriptions`)
# for the control plane image of the e2e cluster only (//deploy:load_e2e_control_plane). Never
# pushed: the release image is built from `:dark-factory`.
rust_binary(
    name = "dark-factory-dev",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["dev-tools"],
    crate_name = "dark_factory",
    crate_root = "src/main.rs",
    edition = "2024",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//crates/df-agent-channel:df_agent_channel",
        "//crates/df-core:df_core",
        "//crates/df-db:df_db",
        "//crates/df-gateway:df_gateway",
        "//crates/df-k8s:df_k8s",
        "//crates/df-plugins:df_plugins",
        "//crates/df-proto:df_proto",
        "//crates/df-telemetry:df_telemetry",
        "//crates/df-web:df_web",
    ],
)

# Rebuilt from source (instead of `crate = ":dark-factory"`) so that the tests can use the
# `test-util` variant of `df-agent-channel` without the binary linking it.
rust_test(
    name = "dark_factory_test",
    tags = ["no-remote-exec"],
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["//plugins/forgejo:tests/fixtures/webhooks/pull_request_closed.json"],
    crate_root = "src/main.rs",
    data = ["//plugins/forgejo"],
    edition = "2024",
    env = {"FORGEJO_PLUGIN_WASM": "$(rootpath //plugins/forgejo)"},
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        "//crates/df-agent-channel:df_agent_channel_test_util",
        "//crates/df-core:df_core",
        "//crates/df-db:df_db",
        "//crates/df-gateway:df_gateway",
        "//crates/df-k8s:df_k8s",
        "//crates/df-plugins:df_plugins",
        "//crates/df-proto:df_proto",
        "//crates/df-telemetry:df_telemetry",
        "//crates/df-test-postgres:df_test_postgres",
        "//crates/df-web:df_web",
    ],
)

rust_test(
    name = "cli_test",
    srcs = ["tests/cli.rs"],
    data = [":dark-factory"],
    edition = "2024",
    env = {"DF_TEST_BIN": "$(rootpath :dark-factory)"},
    lint_config = ":lints",
    deps = all_crate_deps(normal_dev = True),
)
