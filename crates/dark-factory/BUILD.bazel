load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_binary(
    name = "dark-factory",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//crates/df-agent-channel:df_agent_channel",
        "//crates/df-core:df_core",
        "//crates/df-db:df_db",
        "//crates/df-gateway:df_gateway",
        "//crates/df-k8s:df_k8s",
        "//crates/df-plugins:df_plugins",
        "//crates/df-proto:df_proto",
        "//crates/df-web:df_web",
    ],
)

# Rebuilt from source (instead of `crate = ":dark-factory"`) so that the tests can use the
# `test-util` variant of `df-agent-channel` without the binary linking it.
rust_test(
    name = "dark_factory_test",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_root = "src/main.rs",
    data = ["//plugins/forgejo"],
    edition = "2024",
    env = {"FORGEJO_PLUGIN_WASM": "$(rootpath //plugins/forgejo)"},
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        "//crates/df-agent-channel:df_agent_channel_test_util",
        "//crates/df-core:df_core",
        "//crates/df-db:df_db",
        "//crates/df-gateway:df_gateway",
        "//crates/df-k8s:df_k8s",
        "//crates/df-plugins:df_plugins",
        "//crates/df-proto:df_proto",
        "//crates/df-test-postgres:df_test_postgres",
        "//crates/df-web:df_web",
    ],
)

rust_test(
    name = "cli_test",
    srcs = ["tests/cli.rs"],
    data = [":dark-factory"],
    edition = "2024",
    env = {"DF_TEST_BIN": "$(rootpath :dark-factory)"},
    deps = all_crate_deps(normal_dev = True),
)
