load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

exports_files(["Cargo.toml"])

filegroup(
    name = "rs_srcs",
    srcs = glob(["src/**/*.rs"]),
)

alias(
    name = "tailwindcss",
    actual = "@multitool//tools/tailwindcss",
)

alias(
    name = "swc",
    actual = "@multitool//tools/swc",
)

# One minified `.js` per `scripts/<name>.ts`, in `web_scripts/`; `build.rs` embeds them as `<name>.js`.
filegroup(
    name = "ts_srcs",
    srcs = glob(["scripts/*.ts"]),
)

genrule(
    name = "web_scripts",
    srcs = [
        ".swcrc",
        ":ts_srcs",
    ],
    outs = [
        "web_scripts/" + src.removeprefix("scripts/").removesuffix(".ts") + ".js"
        for src in glob(["scripts/*.ts"])
    ],
    cmd = """
        for src in $(locations :ts_srcs); do
            name=$$(basename "$$src" .ts)
            $(execpath :swc) compile "$$src" --config-file $(location .swcrc) \
                --out-file "$(RULEDIR)/web_scripts/$$name.js"
        done
    """,
    tools = [":swc"],
)

genrule(
    name = "app_css",
    srcs = [
        "styles/input.css",
        ":rs_srcs",
    ],
    outs = ["app.css"],
    cmd = """
        TMP=$$(mktemp -d)
        trap 'rm -rf "$$TMP"' EXIT
        TMPDIR="$$TMP" $(execpath :tailwindcss) --input $(location styles/input.css) --output $@ --minify
    """,
    tools = [":tailwindcss"],
)

cargo_build_script(
    name = "build_script",
    srcs = [
        "build.rs",
        "build_assets.rs",
    ],
    build_script_env = {
        "DF_WEB_REQUIRE_ASSETS": "1",
        "TAILWIND_APP_CSS": "$(execpath :app_css)",
        "WEB_SCRIPTS": "$(execpaths :web_scripts)",
    },
    crate_root = "build.rs",
    data = glob(["assets/**"]) + [
        ":app_css",
        ":web_scripts",
    ],
    edition = "2024",
    proc_macro_deps = all_crate_deps(build_proc_macro = True),
    deps = all_crate_deps(build = True),
)

rust_library(
    name = "df_web",
    srcs = [
        "build_assets.rs",
        ":rs_srcs",
    ],
    aliases = aliases(),
    # `scripts/**`: the tests embed the TypeScript sources (`assets::script_source`).
    compile_data = glob([
        "assets/**",
        "scripts/**",
    ]) + ["src/components/brands.json"],
    crate_name = "df_web",
    edition = "2024",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        ":build_script",
        "//crates/df-core:df_core",
        "//crates/df-db:df_db",
        "//crates/df-proto:df_proto",
    ],
)

alias(
    name = "df-web",
    actual = ":df_web",
)

rust_test(
    name = "df_web_test",
    compile_data = [
        "styles/input.css",
        "//deploy:helm/dark-factory/values.schema.json",
        "//docs:design-system.md",
    ],
    crate = ":df_web",
    data = glob(["src/**/snapshots/*.snap"]),
    env = {
        "INSTA_UPDATE": "no",
        "INSTA_WORKSPACE_ROOT": ".",
    },
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal_dev = True) + [
        ":build_script",
        "//crates/df-agent-channel:df_agent_channel_test_util",
        "//crates/df-core:df_core",
        "//crates/df-db:df_db",
        "//crates/df-proto:df_proto",
        "//crates/df-test-postgres:df_test_postgres",
    ],
)
