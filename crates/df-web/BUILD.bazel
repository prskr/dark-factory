load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@npm_df_web//:defs.bzl", "npm_link_all_packages")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_test")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

exports_files(["Cargo.toml"])

npm_link_all_packages(name = "node_modules")

# The files of the npm packages that `build_assets.rs` serves (its `VENDOR` table), copied to
# `vendor_scripts/<package>/<file>`; the build script matches them by that suffix. No label carries
# a version, so a Renovate bump touches only `package.json` and `pnpm-lock.yaml`.
# `package.json` of each package is for the test that compares the installed versions with ours.
VENDOR_FILES = {
    "alpinejs": [
        "dist/cdn.min.js",
        "package.json",
    ],
    "htmx.org": [
        "dist/htmx.min.js",
        "dist/ext/hx-sse.min.js",
        "package.json",
    ],
    "mermaid": [
        "dist/mermaid.min.js",
        "package.json",
    ],
}

[
    filegroup(
        name = "pkg_" + package.replace(".", "_"),
        srcs = [":node_modules/" + package],
        output_group = "package_directory",
    )
    for package in VENDOR_FILES
]

genrule(
    name = "vendor_scripts",
    srcs = [":pkg_" + package.replace(".", "_") for package in VENDOR_FILES],
    outs = [
        "vendor_scripts/" + package + "/" + file
        for package, files in VENDOR_FILES.items()
        for file in files
    ],
    cmd = "\n".join([
        "mkdir -p $(RULEDIR)/vendor_scripts/%s/%s && cp $(location :pkg_%s)/%s $(RULEDIR)/vendor_scripts/%s/%s" % (
            package,
            file.rpartition("/")[0],
            package.replace(".", "_"),
            file,
            package,
            file,
        )
        for package, files in VENDOR_FILES.items()
        for file in files
    ]),
)

filegroup(
    name = "rs_srcs",
    srcs = glob(["src/**/*.rs"]),
)

alias(
    name = "tailwindcss",
    actual = "@multitool//tools/tailwindcss",
)

alias(
    name = "swc",
    actual = "@multitool//tools/swc",
)

# One minified `.js` per `scripts/<name>.ts`, in `web_scripts/`; `build.rs` embeds them as `<name>.js`.
filegroup(
    name = "ts_srcs",
    srcs = glob(["scripts/*.ts"]),
)

genrule(
    name = "web_scripts",
    srcs = [
        ".swcrc",
        ":ts_srcs",
    ],
    outs = [
        "web_scripts/" + src.removeprefix("scripts/").removesuffix(".ts") + ".js"
        for src in glob(["scripts/*.ts"])
    ],
    cmd = """
        for src in $(locations :ts_srcs); do
            name=$$(basename "$$src" .ts)
            $(execpath :swc) compile "$$src" --config-file $(location .swcrc) \
                --out-file "$(RULEDIR)/web_scripts/$$name.js"
        done
    """,
    tools = [":swc"],
)

genrule(
    name = "app_css",
    srcs = [
        "styles/input.css",
        ":rs_srcs",
    ],
    outs = ["app.css"],
    cmd = """
        TMP=$$(mktemp -d)
        trap 'rm -rf "$$TMP"' EXIT
        TMPDIR="$$TMP" $(execpath :tailwindcss) --input $(location styles/input.css) --output $@ --minify
    """,
    tools = [":tailwindcss"],
)

cargo_build_script(
    name = "build_script",
    srcs = [
        "build.rs",
        "build_assets.rs",
    ],
    build_script_env = {
        "DF_WEB_REQUIRE_ASSETS": "1",
        "TAILWIND_APP_CSS": "$(execpath :app_css)",
        "VENDOR_SCRIPTS": "$(execpaths :vendor_scripts)",
        "WEB_SCRIPTS": "$(execpaths :web_scripts)",
    },
    crate_root = "build.rs",
    data = glob(["assets/**"]) + [
        ":app_css",
        ":vendor_scripts",
        ":web_scripts",
    ],
    edition = "2024",
    proc_macro_deps = all_crate_deps(build_proc_macro = True),
    deps = all_crate_deps(build = True),
)

rust_library(
    name = "df_web",
    srcs = [
        "build_assets.rs",
        ":rs_srcs",
    ],
    aliases = aliases(),
    # `scripts/**`: the tests embed the TypeScript sources (`assets::script_source`);
    # `package.json`: a test compares the vendor table with it.
    compile_data = glob([
        "assets/**",
        "scripts/**",
    ]) + [
        "package.json",
        "src/components/brands.json",
    ],
    crate_name = "df_web",
    edition = "2024",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        ":build_script",
        "//crates/df-core:df_core",
        "//crates/df-db:df_db",
        "//crates/df-proto:df_proto",
    ],
)

alias(
    name = "df-web",
    actual = ":df_web",
)

rust_test(
    name = "df_web_test",
    compile_data = [
        "styles/input.css",
        "//deploy:helm/dark-factory/values.schema.json",
        "//docs:design-system.md",
    ],
    crate = ":df_web",
    data = glob(["src/**/snapshots/*.snap"]) + [":vendor_scripts"],
    env = {
        "INSTA_UPDATE": "no",
        "INSTA_WORKSPACE_ROOT": ".",
        "VENDOR_SCRIPTS": "$(rootpaths :vendor_scripts)",
    },
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal_dev = True) + [
        ":build_script",
        "//crates/df-agent-channel:df_agent_channel_test_util",
        "//crates/df-core:df_core",
        "//crates/df-db:df_db",
        "//crates/df-proto:df_proto",
        "//crates/df-test-postgres:df_test_postgres",
    ],
)
