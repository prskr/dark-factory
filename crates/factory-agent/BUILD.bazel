load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//cargo:defs.bzl", "extract_cargo_lints")
load("@rules_rust//rust:defs.bzl", "rust_binary", "rust_test")
load("//build:empty_dir.bzl", "empty_dir")

package(default_visibility = ["//visibility:public"])

extract_cargo_lints(
    name = "lints",
    manifest = "Cargo.toml",
    workspace = "//:Cargo.toml",
)

exports_files([
    "Cargo.toml",
    "docs/configuration.md",
    "image/gitconfig",
])

empty_dir(
    name = "hooks_empty",
)

rust_binary(
    name = "factory-agent",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    edition = "2024",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True) + [
        "//crates/df-proto:df_proto",
        "//crates/df-telemetry:df_telemetry_slim",
    ],
)

# Rebuilt from source (instead of `crate = ":factory-agent"`) so that the tests can use the
# `test-util` variant of `df-telemetry` without the binary linking it.
rust_test(
    name = "factory_agent_test",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["docs/configuration.md"],
    crate_root = "src/main.rs",
    edition = "2024",
    lint_config = ":lints",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(
        normal = True,
        normal_dev = True,
    ) + [
        "//crates/df-proto:df_proto",
        "//crates/df-telemetry:df_telemetry_slim_test_util",
    ],
)

rust_test(
    name = "cli_test",
    srcs = ["tests/cli.rs"],
    data = [":factory-agent"],
    edition = "2024",
    env = {"DF_TEST_BIN": "$(rootpath :factory-agent)"},
    lint_config = ":lints",
)
