common --experimental_convenience_symlinks=clean
# The agent sandbox sets HOME under /workspace/.paperclip-runtime, which places
# Bazel's default cache inside the workspace root. Bazel errors out unless this is disabled.
common --repo_contents_cache=

# The workspace .bazelrc is always read: importing it again duplicates flags such as --aspects.

# Share build outputs through the BuildBuddy remote cache (builds and tests run locally)
build --config=cache
