load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "test_probe_plugin_lib",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["//contract:wit_integrations"],
    crate_name = "test_probe_plugin",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

rust_shared_library(
    name = "test-probe",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["//contract:wit_integrations"],
    crate_name = "test_probe_plugin",
    edition = "2024",
    platform = "//build/platforms:wasm32_wasip2",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)
