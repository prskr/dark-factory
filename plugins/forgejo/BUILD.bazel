load("@crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_shared_library", "rust_test")

package(default_visibility = ["//visibility:public"])

exports_files(["Cargo.toml"])

rust_library(
    name = "forgejo_plugin_lib",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["//contract:wit_integrations"],
    crate_name = "forgejo_plugin",
    edition = "2024",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

rust_shared_library(
    name = "forgejo",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    compile_data = ["//contract:wit_integrations"],
    crate_name = "forgejo_plugin",
    edition = "2024",
    platform = "//build/platforms:wasm32_wasip2",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    deps = all_crate_deps(normal = True),
)

rust_test(
    name = "forgejo_plugin_test",
    compile_data = ["//contract:wit_integrations"],
    crate = ":forgejo_plugin_lib",
    proc_macro_deps = all_crate_deps(
        proc_macro = True,
        proc_macro_dev = True,
    ),
    deps = all_crate_deps(normal_dev = True),
)
