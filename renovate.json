{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":disableRateLimiting",
    ":prConcurrentLimit10",
    "customManagers:githubActionsVersions"
  ],
  "postUpgradeTasks": {
    "commands": [
      "bazel mod tidy"
    ],
    "fileFilters": [
      "MODULE.bazel",
      "MODULE.bazel.lock"
    ],
    "executionMode": "update"
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Default harness image tag (the adapter version) in code and reference docs; deploy/images/check_versions.sh lists the same copies",
      "managerFilePatterns": [
        "/^crates/df-core/src/config\\.rs$/",
        "/^crates/df-k8s/README\\.md$/",
        "/^crates/df-agent-channel/docs/configuration\\.md$/"
      ],
      "matchStrings": [
        "ghcr\\.io/prskr/dark-factory/claude-harness:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "@agentclientprotocol/claude-agent-acp",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Default harness image tag (the adapter version) of the Helm chart",
      "managerFilePatterns": [
        "/^deploy/helm/dark-factory/values\\.yaml$/"
      ],
      "matchStrings": [
        "claudeCode:\\n\\s+repository: \\S+\\n\\s+tag: '(?<currentValue>\\d+\\.\\d+\\.\\d+)'"
      ],
      "depNameTemplate": "@agentclientprotocol/claude-agent-acp",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "Default harness image tag (the adapter version) in the chart reference",
      "managerFilePatterns": [
        "/^deploy/helm/dark-factory/README\\.md$/"
      ],
      "matchStrings": [
        "`image\\.harness\\.claudeCode\\.tag` \\| `string` \\| `\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"`"
      ],
      "depNameTemplate": "@agentclientprotocol/claude-agent-acp",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "OpenCode release the opencode-harness image ships; the checksums of the two archives in MODULE.bazel are updated by hand (deploy/images/check_versions.sh lists the copies of the version)",
      "managerFilePatterns": [
        "/^MODULE\\.bazel$/"
      ],
      "matchStrings": [
        "OPENCODE_VERSION = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "anomalyco/opencode",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Default OpenCode harness image tag (the OpenCode version) in code and reference docs",
      "managerFilePatterns": [
        "/^crates/df-core/src/config\\.rs$/",
        "/^crates/df-k8s/README\\.md$/",
        "/^crates/df-agent-channel/docs/configuration\\.md$/"
      ],
      "matchStrings": [
        "ghcr\\.io/prskr/dark-factory/opencode-harness:(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "anomalyco/opencode",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Default OpenCode harness image tag of the Helm chart",
      "managerFilePatterns": [
        "/^deploy/helm/dark-factory/values\\.yaml$/"
      ],
      "matchStrings": [
        "opencode:\\n\\s+repository: \\S+\\n\\s+tag: '(?<currentValue>\\d+\\.\\d+\\.\\d+)'"
      ],
      "depNameTemplate": "anomalyco/opencode",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Default OpenCode harness image tag in the chart reference",
      "managerFilePatterns": [
        "/^deploy/helm/dark-factory/README\\.md$/"
      ],
      "matchStrings": [
        "`image\\.harness\\.opencode\\.tag` \\| `string` \\| `\"(?<currentValue>\\d+\\.\\d+\\.\\d+)\"`"
      ],
      "depNameTemplate": "anomalyco/opencode",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Rust version of the Bazel toolchains; must equal `channel` in rust-toolchain.toml (rust-toolchain manager)",
      "managerFilePatterns": [
        "/^MODULE\\.bazel$/"
      ],
      "matchStrings": [
        "RUST_VERSION = \"(?<currentValue>\\d+\\.\\d+\\.\\d+)\""
      ],
      "depNameTemplate": "rust",
      "datasourceTemplate": "rust-version"
    },
    {
      "customType": "regex",
      "description": "OpenSpec CLI run through npx in CI and in the pre-commit hook",
      "managerFilePatterns": [
        "/^\\.github/workflows/openspec\\.yaml$/",
        "/^lefthook\\.yml$/"
      ],
      "matchStrings": [
        "npx --yes @fission-ai/openspec@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "@fission-ai/openspec",
      "datasourceTemplate": "npm"
    },
    {
      "customType": "regex",
      "description": "TypeScript compiler run through npx in CI and in the pre-commit hook",
      "managerFilePatterns": [
        "/^\\.github/workflows/ci\\.yaml$/",
        "/^lefthook\\.yml$/"
      ],
      "matchStrings": [
        "npx --yes -p typescript@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "depNameTemplate": "typescript",
      "datasourceTemplate": "npm"
    }
  ],
  "packageRules": [
    {
      "description": "One PR for the adapter: package.json, pnpm-lock.yaml and every copy of the image tag",
      "matchPackageNames": [
        "@agentclientprotocol/claude-agent-acp"
      ],
      "groupName": "Claude harness adapter"
    },
    {
      "description": "One PR per OpenCode release: MODULE.bazel and every copy of the image tag; the release is checked with the image test and one manual run (openspec change iter3-opencode-harness)",
      "matchPackageNames": [
        "anomalyco/opencode"
      ],
      "groupName": "OpenCode harness"
    },
    {
      "description": "Our own images are tagged by the release (and the harness by the adapter version above), not looked up in the registry",
      "matchManagers": [
        "helm-values"
      ],
      "matchPackageNames": [
        "ghcr.io/prskr/dark-factory/**"
      ],
      "enabled": false
    },
    {
      "description": "One PR for the Rust toolchain: rust-toolchain.toml and RUST_VERSION in MODULE.bazel",
      "matchDatasources": [
        "rust-version"
      ],
      "groupName": "Rust toolchain"
    },
    {
      "description": "One PR for OpenSpec: the CI workflow and the lefthook hook",
      "matchPackageNames": [
        "@fission-ai/openspec"
      ],
      "groupName": "OpenSpec CLI"
    },
    {
      "description": "One PR for TypeScript: the CI workflow and the lefthook hook",
      "matchPackageNames": [
        "typescript"
      ],
      "groupName": "TypeScript compiler"
    }
  ]
}
